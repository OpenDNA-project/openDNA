     gene            3328268..3328546
                     /gene="sfsB"
                     /locus_tag="b3188"
                     /label=sfsB
     CDS             3328268..3328546
                     /codon_start=1
                     /gene="sfsB"
                     /locus_tag="b3188"
                     /product="putative transcriptional regulator SfsB"
                     /label=sfsB
                     /note="This regulator participates in controlling several
                     genes involved in maltose metabolism |CITS: [2013578]|. It 
                     is similar to the Ner repressor protein of phage Mu.
                     SfsB is not essential for viability |CITS: [1534062]|.
                     The SfsB binding landscape was globally mapped in vivo by 
                     standardized ChIP-seq and quantitatively modeled using 
                     BoltzNet, a biophysically informed neural network that 
                     infers binding energy from sequence data |CITS:[40335485]|.
                     The resulting ChIP-seq binding regions are available in 
                     RegulonDB (<a href=""https://regulondb.cc 
                     g.unam.mx/ht/dataset/TFBINDING/source=GALAGAN"">Galagan 
                     collection</a>), and the corresponding energy matrix and 
                     genomic binding profiles can be accessed at <a 
                     href=""http://boltznet.bu.edu"">boltznet.bu.edu</a> 
                     |CITS:[40335485]|.
                     SfsB: ""sugar fermentation stimulation"" |CITS: 
                     [2013578]|<br>Nlp: ""Ner-like protein"" |CITS: [2670911]|"
                     /translation="MESNFIDWHPADIIAGLRKKGTSMAAESRRNGLSSSTLANALSRP
                     WPKGEMIIAKALGTDPWVIWPSRYHDPQTHEFIDRTQLMRSYTKPKK"
