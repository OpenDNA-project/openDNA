     gene            complement(2296229..2296492)
                     /gene="napD"
                     /locus_tag="b2207"
                     /label=napD
     CDS             complement(2296229..2296492)
                     /codon_start=1
                     /gene="napD"
                     /locus_tag="b2207"
                     /product="NapA signal peptide-binding chaperone NapD"
                     /label=napD
                     /note="NapD is a dedicated chaperone for |FRAME: EG12067
                     NapA|, the molybdoprotein subunit of the periplasmic 
                     nitrate reductase.  It binds specifically to the 
                     twin-arginine signal peptide of NapA, preventing premature 
                     export.  In the absence of NapD, NapA is unstable and 
                     degraded |CITS: [10548535][17901208][19151138]|.
                     NapD defines a second family of twin-arginine signal 
                     peptide binding proteins (see also the |FRAME: 
                     EG12195-MONOMER ""TorD""| chaperone).  The solution 
                     structure of NapD has been solved, showing a 
                     ferredoxin-like fold |CITS: [17901208]|.  A NapD binding 
                     epitope is located towards the N-terminus of the NapA 
                     signal peptide and partially overlaps with the twin 
                     arginine motif |CITS: [22329966]|.  An NMR structure of the
                     NapD-NapA signal peptide complex has been reported |CITS: 
                     [22329966]|.  NapA lacking its signal peptide does not form
                     a NapD-NapA complex |CITS: [24314029]|.
                     NapD: ""<b>n</b>itr<b>a</b>te reductase in the 
                     <b>p</b>eriplasm"" |CITS: [8830238]|
                     Review: |CITS: [8919448]|"
