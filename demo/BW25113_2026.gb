     gene            complement(1306105..1306503)
                     /gene="yciA"
                     /locus_tag="b1253"
                     /label=yciA
     CDS             complement(1306105..1306503)
                     /codon_start=1
                     /gene="yciA"
                     /locus_tag="b1253"
                     /product="bifunctional acyl-CoA thioesterase YciA /
                     acyl-CoA thioesterase"
                     /EC_number="3.1.2.20"
                     /label=yciA
                     /note="YciA is an acyl-CoA thioesterase with broad
                     substrate specificity |CITS: [18247525]|.  Esterase 
                     activity of YciA was first discovered in a high-throughput 
                     screen of purified proteins |CITS: [15808744]|.
                     YciA homologs exist in a wide variety of bacteria.  The 
                     <i>Haemophilus influenzae</i> enzyme is a homohexamer and 
                     has been crystallized |CITS: [18247525]|.
                     A <i>yciA</i> null mutant does not have an obvious growth 
                     defect |CITS: [18247525]|.  A <i>yciA</i> deletion mutant 
                     in the EB228 strain background produces significantly less 
                     butyrate than its parent |CITS: [31312512]|."
                     /translation="MSTTHNVPQGDLVLRTLAMPADTNANGDIFGGWLMSQMDIGGAIL
