                     /go_process="single-species biofilm formation on inanimate
                     substrate [goid 0044011] [evidence IMP] [PMID 19919618]"
     gene            complement(4203608..4204051)
                     /gene="yjaB"
                     /locus_tag="b4012"
                     /label=yjaB
     CDS             complement(4203608..4204051)
                     /codon_start=1
                     /gene="yjaB"
                     /locus_tag="b4012"
                     /product="bifunctional peptidyl-lysine N-acetyltransferase
                     YjaB / peptidyl-lysine N-acetyltransferase"
                     /label=yjaB
                     /note="YjaB is an <i>N&epsilon;</i>-lysine
                     acetyltransferase that targets 171 unique lysine residues 
                     in 128 proteins |CITS: [30352934]|.
                     Overexpression of YjaB in an acetylation-gutted strain 
                     (&Delta; <i>pta patZ acs cobB</i>) leads to the appearance 
                     of acetylated proteins in an anti-acetyllysine Western 
                     blot. Mutagenesis of a predicted catalytic residue in YjaB,
                     Y117A, eliminates the acetylation signal observed with the 
                     wild-type protein |CITS: [30352934]|.
                     An NMR solution structure of apo-YjaB has been generated, 
                     showing a structure typical for Gcn5-related 
                     <i>N</i>-acetyltransferases (GNATs). Addition of acetyl-CoA
                     caused chemical shifts in the NMR structure, indicating 
                     that YjaB is able to bind acetyl-CoA |CITS: [19343803]|.
                     A <i>yjaB</i> insertion mutant is viable |CITS: [9311119]|.
                     Review: |CITS: [34721364]|"
                     /translation="MVISIRRSRHEEGEELVAIWCRSVDATHDFLSAEYRTELEDLVRS
