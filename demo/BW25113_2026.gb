     gene            1254247..1254525
                     /gene="ychH"
                     /locus_tag="b1205"
                     /label=ychH
     CDS             1254247..1254525
                     /codon_start=1
                     /gene="ychH"
                     /locus_tag="b1205"
                     /product="stress-induced protein"
                     /label=ychH
                     /note="YchH is involved in the cellular response to
                     hydrogen peroxide and cadmium stress |CITS: [19919618]|.
                     A <i>ychH</i> mutant is much more sensitive to hydrogen 
                     peroxide and cadmium stress than wild type and shows 
                     increased biofilm formation.  In a metabolically engineered
                     strain that expresses genes required for the degradation of
                     <i>cis</i>-dichloroethylene (<i>cis</i>-DCE), <i>ychH</i> 
                     expression is induced. Moreover, YchH is important for 
                     degradation of <i>cis</i>-DCE |CITS: [19919618]|.
                     CRP functions as a Class II activator at the <i>ychH</i> 
                     promoter |CITS: [17608696]|.
                     |FRAME: EG11533| was significantly upregulated in simulated
                     microgravity |CITS: [35940684]|."
                     /translation="MKRKNASLLGNVLMGLGLVVMVVGVGYSILNQLPQFNMPQYFAHG
                     AVLSIFVGAILWLAGARVGGHEQVCDRYWWVRHYDKRCRRSDNRRHS"
