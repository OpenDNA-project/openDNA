                     /translation="MFKFLVLTLGIISCQAYAEDTVIVNDHDISAIKDCWQKNSDDDTD
                     VNVIKSCLRQEYNLVDAQLNKAYGEAYRYIEQVPRTGVKKPDTEQLNLLKKSQRAWLDF
