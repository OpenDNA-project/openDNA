     gene            2011867..2012994
                     /gene="fliK"
                     /locus_tag="b1943"
                     /label=fliK
     CDS             2011867..2012994
                     /codon_start=1
                     /gene="fliK"
                     /locus_tag="b1943"
                     /product="flagellar hook-length control protein"
                     /label=fliK
                     /note="FliK is a soluble component of the flagellar export 
                     apparatus.  FliK has been shown to coordinate (in 
                     conjunction with FlhB) switching of substrate specificity 
                     of the export apparatus from rod/hook-type proteins to 
                     filament-type proteins |CITS: [10944190][11264537]|.  Upon 
                     completion of the flagellar hook structure, the C-terminal 
                     domain of FliK is able to communicate (though perhaps not 
                     directly) with the C-terminal cytoplasmic domain of 
                     integral membrane protein FlhB |CITS: [10940035]|.  This 
                     causes a change in subdomain interactions within FlhB which
                     results in switching of export substrate specificity |CITS:
                     [15170399]|."
                     /translation="MIRLAPLITADVDTTTLPGGKASDAAQDFLALLSEALAGETTTDK
                     AAPQLLVATDKPTTKGEPLISDIVSDAQQANLLIPVDETPPVINDEQSTSTPLTTAQTM
