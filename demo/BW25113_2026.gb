     gene            complement(4523613..4523870)
                     /gene="topAI"
                     /locus_tag="b4566"
                     /label=topAI
     CDS             complement(4523613..4523870)
                     /codon_start=1
                     /gene="topAI"
                     /locus_tag="b4566"
                     /product="KpLE2 phage-like element; toxin of the
                     TopAI-YjhQ toxin-antitoxin system, TopA inhibitor"
                     /label=topAI
                     /note="Overexpression of TopAI is toxic; concurrent
                     expression of YjhQ relieves TopAI toxicity. TopAI directly 
                     interacts with a DNA-|FRAME: EG11013-MONOMER| complex and 
                     inhibits topoisomerase activity. <i>topAI</i> and 
                     <i>|FRAME: G7917|</i> genes encode a type II 
                     toxin-antitoxin system |CITS: [26553797]|.
                     <i>topAI</i> is translationally repressed and has a long 
                     upstream region with a Rho utilization (Rut) sequence which
                     can be occupied by Rho when translation is repressed. 
                     Upregulation of <i>topAI</i> occurs as a result of 
                     mutations in the |FRAME: EG10845| gene or mutations in 23S 
                     rRNA (specifically in domain IV, helix 69 or in domain V, 
                     helix 80). Translational stress, such as the presence of 
                     ribosome-targeting antibiotics, can also alleviate the 
                     translational repression. A small RNA upstream of the 
                     <i>topAI</i> gene (named <i>|FRAME: G0-17140|</i>) was 
                     identified as a cis-acting regulatory element that is 
                     required for inducing expression of the TopAI operon in the
                     presence of ribosome-targeting antibiotics |CITS: 
                     [40439554]|.
                     TopAI: ""<b>TopA</b> <b>i</b>nhibitor"" |CITS: [26553797]|"
                     /translation="MNLSRQEQHTLHVLAKGRRIAHVRDSSGRVTSVECYSREGLLLTD
                     CTLAVFKKLKTKKLIKSVNGQPYRINTTELNKVRAQLDNR"
                     /go_function="protein binding [goid 0005515] [evidence
                     IPI] [PMID 26553797]"
                     /go_function="DNA topoisomerase binding [goid 0044547]
                     [evidence IDA] [PMID 26553797]"
     gene            complement(4523983..4524009)
                     /gene="toiL"
                     /locus_tag="b4848"
                     /label=toiL
     CDS             complement(4523983..4524009)
                     /codon_start=1
                     /gene="toiL"
                     /locus_tag="b4848"
                     /product="uORF ToiL"
                     /label=toiL
                     /note="When translation is not under stress, an RNA
                     hairpin spanning the <i>toiL</i> uORF and the <i>topAI</i> 
                     ribosome-binding site masks the <i>topAI</i> RBS, blocking 
                     translation initiation and thereby favoring premature 
                     Rho-dependent transcription termination within the<i> 
                     topAI</i> coding region |CITS: [40439554]|. In this 
                     repressed state, <i>toiL</i> is likely translated 
                     efficiently, but ribosomes moving through <i>toiL</i> only 
                     briefly unwind the hairpin. In contrast, when translation 
                     stress is triggered-particularly by ribosome-targeting 
                     antibiotics-ribosomes stall within <i>toiL</i>, which 
                     disrupts the inhibitory hairpin, allows <i>topAI</i> 
                     translation to proceed, and consequently suppresses 
                     premature Rho-dependent termination within <i>topAI</i> 
                     |CITS: [40439554]|.
                     ToiL is conserved across a variety of Enterobacteriaceae 
                     species |CITS: [40439554]|."
                     /translation="MLENVIIR"
