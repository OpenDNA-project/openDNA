     gene            1601256..1601546
                     /gene="lsrG"
                     /locus_tag="b1518"
                     /label=lsrG
     CDS             1601256..1601546
                     /codon_start=1
                     /gene="lsrG"
                     /locus_tag="b1518"
                     /product="bifunctional 
                     (4S)-4-hydroxy-5-phosphonooxypentane-2,3-dione isomerase / 
                     Autoinducer-2 degrading protein"
                     /EC_number="5.3.1.32"
                     /label=lsrG
                     /note="LsrG is an enzyme involved in the degradation of
                     the quorum-sensing regulator Autoinducer 2 (AI-2). Purified
                     LsrG degrades |FRAME: CPD-10551 phospho-AI-2| 
                     (4-hydroxy-2,3-pentanedione 5-phosphate) |CITS: 
                     [17274596]|.  The reaction products were later shown to be 
                     a mixture of |FRAME: CPD0-2467| (P-HPD) and |FRAME: 
                     CPD0-2468| (P-TPO); |FRAME: CPD0-2466| was proposed to be a
                     reaction intermediate |CITS: [21454635]|.  It is now 
                     thought that LsrG catalyzes the isomerization reaction from
                     phospho-AI-2 to P-HPD, and that P-HPD exists in equilibrium
                     with its hydrated form, P-TPO |CITS: [25225400]|.
                     A crystal structure of the enzyme has been solved at 1.8 
                     &Aring; resolution.  Mutants in predicted active site 
                     residues N25, E54, H65, H70 have reduced or no catalytic 
                     activity <i>in vitro</i> |CITS: [21454635]|.
                     LsrG: ""<i><b>l</b>ux<b>S</b></i> <b>r</b>egulated"" |CITS:
                     [11722742]|"
                     /translation="MHVTLVEINVHEDKVDEFIEVFRQNHLGSVQEEGNLRFDVLQDPE
