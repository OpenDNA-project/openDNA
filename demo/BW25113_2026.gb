     gene            4321933..4322022
                     /gene="pmrR"
                     /locus_tag="b4703"
                     /label=pmrR
     CDS             4321933..4322022
                     /codon_start=1
                     /gene="pmrR"
                     /locus_tag="b4703"
                     /product="small regulatory membrane protein PmrR"
                     /label=pmrR
                     /note="First characterized in |FRAME: TAX-90371| |CITS: 
                     [22921935]|, <i>pmrR</i> encodes a small inner membrane 
                     protein which, under BasSR-inducing conditions (high 
                     concentrations of Fe<sup>3+</sup>, mildly acidic pH), 
                     inhibits the |FRAME: G7146-MONOMER LpxT|-dependent 
                     generation of lipid A-core 1-diphosphate |CITS: 
                     [34017319][20384697]|.
                     Inactivation of <i>pmrR</i> in the polymyxin-resistant, 
                     deoxycholate-sensitive |FRAME: EG11615 
                     BasR(PmrA)|-constitutive strain WD101 results in 
                     sensitivity to polymyxin B and resistance to deoxycholate 
                     |CITS: [34017319]|.
                     PmrR-mediated regulation of LpxT activity in 
                     <i>Salmonella</i>, constitutes a negative feedback 
                     mechanism for control of the PmrA-PmrB two-component system
                     which governs transcription of lipopolysaccharide-modifying
                     genes |CITS: [22921935]|.
                     "
                     /translation="MKNRVYESLTTVFSVLVVSSFLYIWFATY"
