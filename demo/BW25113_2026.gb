     CDS             2158670..2159002
                     /codon_start=1
                     /gene="yegP"
                     /locus_tag="b2080"
                     /product="DUF1508 domain-containing protein YegP"
                     /label=yegP
                     /note="A &Delta;<i>yegP</i> mutant has a high number of 
                     aggravating genetic interactions in response to MMS with 
                     genes involved in the DNA damage response, DNA repair, 
                     replication and recombination.  YegP may function in 
                     parallel with RecFOR in the double-strand break repair 
                     pathway |CITS: [26774489]|.
                     "
                     /translation="MAGWFELSKSSDNQFRFVLKAGNGETILTSELYTSKTSAEKGIAS
                     VRSNSPQEERYEKKTASNGKFYFNLKAANHQIIGSSQMYATAQSRETGIASVKANGTSQ
                     TVKDNT"
