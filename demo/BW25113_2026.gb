                     YATTYINIVGKLFNECADFRRTGSAALDLAYVAAGRVDGFFEIGLRPWDFAAGELLVRE
                     AGGIVSDFTGGHNYMLTGNIVAGNPRVVKAMLANMRDELSDALKR"
                     /go_component="cytoplasm [goid 0005737] [evidence IEA]
