     CDS             3767784..3768932
                     /codon_start=1
                     /gene="mtlD"
                     /locus_tag="b3600"
                     /product="mannitol-1-phosphate 5-dehydrogenase"
                     /EC_number="1.1.1.17"
                     /label=mtlD
                     /note="Mannitol is the most common natural hexitol and can
                     serve as a carbon source for <i>E. coli</i>.  After 
                     entering the cell via a dedicated PTS transporter, 
                     mannitol-1-phosphate 5-dehydrogenase (MtlD) oxidizes 
                     mannitol-1-phosphate to fructose-6-phosphate in a 
                     reversible reaction |CITS: [6384188][2111176]|.
                     MtlD activity is induced by growth on mannitol.  An 
                     <i>mtlD</i> mutant does not grow on mannitol as the sole 
                     carbon source |CITS: [4559737]|.
                     MtlD: ""<b>m</b>anni<b>t</b>o<b>l</b>"" |CITS: [4559737]| "
