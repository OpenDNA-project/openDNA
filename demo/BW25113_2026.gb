     gene            1088332..1089690
                     /gene="dgcT"
                     /locus_tag="b1025"
                     /label=dgcT
     CDS             1088332..1089690
                     /codon_start=1
                     /gene="dgcT"
                     /locus_tag="b1025"
                     /product="bifunctional probable diguanylate cyclase DgcT / 
                     diguanylate cyclase"
                     /EC_number="2.7.7.65"
                     /label=dgcT
                     /note="DgcT is a diguanylate cyclase that regulates
                     motility; the effect on motility is probably mediated by 
                     the second messenger molecule c-di-GMP |CITS: [18713317]|. 
                     DgcT has an N-terminal MASE4 (Membrane-Associated SEnsor) 
                     domain, which includes eight transmembrane segments |CITS: 
                     [26148715]|.  The MASE4 domain is followed by the 
                     diguanylate cyclase (GGDEF) domain |CITS: [18713317]|. 
                     Overexpression of DgcT represses swimming behavior |CITS: 
                     [18713317]|.  Expression of DgcT is repressed by CsrA, 
                     which interacts directly with the 5' leader sequence of the
                     <i>dgcT</i> mRNA and modulates the stability of the message
                     |CITS: [18713317]|.
                     DgcT: <b>d</b>i<b>g</b>uanylate <b>c</b>yclase <b>T</b> 
                     |CITS: [26148715]|.
                     Related review: |CITS: [33640237]|"
