                     SYADSMARADDASVVYCDPPYAPLSATANFTAYHTNSFTLEQQAHLAEIAEGLVERHIP
                     VLISNHDTMLTREWYQRAKLHVVKVRRSISSNGGTRKKVDELLALYKPGVVSPAKK"
