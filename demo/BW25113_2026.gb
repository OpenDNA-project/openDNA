     gene            470835..471407
                     /gene="ybaY"
                     /locus_tag="b0453"
                     /label=ybaY
     CDS             470835..471407
                     /codon_start=1
                     /gene="ybaY"
                     /locus_tag="b0453"
                     /product="PF09619 family lipoprotein YbaY"
                     /label=ybaY
                     /note="YbaY is a verified lipoprotein according to
                     unpublished data by S. Matsuyama et al. (cited in |CITS: 
                     [12876315]|).
                     <i>ybaY</i> has supercoiling-dependent transcription, which
                     is associated with the osmotic stress response and acts 
                     through RpoS |CITS: [12566398]|.  <i>ybaY</i> was predicted
                     to be a target of the small RNA OxyS. Overexpression of 
                     OxyS decreases the expression of <i>ybaY</i> |CITS: 
                     [16717284]|.  Expression of <i>ybaY</i> increases in 
                     <i>rpoS</i>-inducing conditions |CITS: 
                     [15576800][15716429]|.  Expression also increases in 
                     response to zinc |CITS: [15659689]|."
                     /translation="MKLVHMASGLAVAIALAACADKSADIQTPAPAANTSISATQQPAI
                     QQPNVSGTVWIRQKVALPPDAVLTVTLSDASLADAPSKVLAQKAVRTEGKQSPFSFVLS
                     FNPADVQPNARILLSAAITVNDKLVFITDTVQPVINQGGTKADLTLVPVQQTAVPVQAS
                     GGATTTVPSTSPTQVNPSSAVPAPTQY"
                     /go_component="plasma membrane [goid 0005886] [evidence
                     IEA] [GO_REF 0000044]"
                     /go_component="outer membrane-bounded periplasmic space
                     [goid 0030288] [evidence IEA] [PMID 19054114]"
