     gene            2442085..2442636
                     /gene="smrB"
                     /locus_tag="b2331"
                     /label=smrB
     CDS             2442085..2442636
                     /codon_start=1
                     /gene="smrB"
                     /locus_tag="b2331"
                     /product="ribosome rescue factor SmrB"
                     /label=smrB
                     /note="Ribosome rescue factor SmrB recognizes and acts on 
                     collided ribosomes; SmrB cleaves mRNAs upstream of stalled 
                     ribosomes and triggers |FRAME: SSRA-RNA|-mediated ribosome 
                     rescue |CITS: [35264790]|. <i>smrB</i> insertion mutations 
                     allow ribosomes to translate through a strong stalling 
                     motif; &Delta;<i>smrB</i> cells are hypersensitive to 
                     erythromycin, an antibiotic that stalls elongating 
                     ribosomes at specific sequences |CITS: [35264790]|.
                     SmrB contains a small mutS-related (SMR) domain with motifs
                     implicated in catalysis and RNA binding |CITS: [35264790]|.
                     Cryo-EM structures of nuclease-deficient SmrB on collided 
                     disomes are available; SmrB binds at the interface of the 
                     two ribosomes and its precise positioning likely activates 
                     catalytic activity |CITS: [35264790]|.
                     <i>smr</i>: <U>s</U>mall <i><U>m</U>utS</i>-<U>r</U>elated 
                     (see |CITS: [10431172]|)"
