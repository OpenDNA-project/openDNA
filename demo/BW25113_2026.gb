     gene            3194566..3195186
                     /gene="ygiM"
                     /locus_tag="b3055"
                     /label=ygiM
     CDS             3194566..3195186
                     /codon_start=1
                     /gene="ygiM"
                     /locus_tag="b3055"
                     /product="putative signal transduction protein (SH3
                     domain)"
                     /label=ygiM
                     /note="Proteomic analysis of membrane preparations
                     suggests that YgiM forms a homo-oligomeric complex |CITS: 
                     [21210718]|. The C-terminus of YgiM is located in the 
                     cytoplasm |CITS: [21210718]|. YgiM is predicted to be a 
                     bitopic inner membrane protein |CITS: [27510400]|. YgiM 
                     contains a carboxy-terminal tail-anchor sequence which 
                     targets to peroxisomes in yeast and mammalian cells |CITS: 
                     [28738827][30401812]|.
                     Transcription of <i>ygiM</i> is regulated by RpoE 
                     (&sigma;<sup>E</sup>) |CITS: [11274153]|.
                     EcfG: ""<b>e</b>xtra<b>c</b>ytoplasmic <b>f</b>unction 
                     <b>G</b>"" |CITS: [11274153]|
                     "
                     /translation="MPKLRLIGLTLLALSATAVSHAEETRYVSDELNTWVRSGPGDHYR
                     LVGTVNAGEEVTLLQTDANTNYAQVKDSSGRTAWIPLKQLSTEPSLRSRVPDLENQVKT
                     LTDKLTNIDNTWNQRTAEMQQKVAQSDSVINGLKEENQKLKNELIVAQKKVDAASVQLD
                     DKQRTIIMQWFMYGGGVLGLGLLLGLVLPHLIPSRKRKDRWMN"
