                     /codon_start=1
                     /gene="arnC"
                     /locus_tag="b2254"
                     /product="undecaprenyl-phosphate
                     4-deoxy-4-formamido-L-arabinose transferase"
                     /EC_number="2.4.2.53"
                     /label=arnC
                     /note="ArnC is an undecaprenyl transferase that acts in a 
                     pathway which modifies lipid A phosphates with 
                     4-amino-4-deoxy-L-arabinose (L-Ara4N), causing increased 
                     resistance to polymyxin |CITS: [11706007]|.  ArnC is an 
                     inner membrane protein with two predicted transmembrane 
                     domains; the C terminus is located in the cytoplasm |CITS: 
                     [15919996]|.
                     ArnC selectively converts uridine 
                     5'-diphospho-&beta;-(4-deoxy-4-formamido-L-arabinose) 
                     (UDP-L-Ara4FN), but not uridine 
                     5'-diphospho-&beta;-(4-amino-4-deoxy-L-arabinose) 
                     (UDP-L-Ara4N), to lipid product |CITS: [15695810]|.
                     ArnC: ""L-<b>Ar</b>a4<b>N</b> (4-amino-4-deoxy-L-arabinose)
                     biosynthesis"" |CITS: [11706007]|
                     PmrF: ""<b>p</b>oly<b>m</b>yxin <b>r</b>esistance"" Review:
                     |CITS: [17362200]|"
