     gene            complement(3133670..3134158)
                     /gene="hybE"
                     /locus_tag="b2992"
                     /label=hybE
     CDS             complement(3133670..3134158)
                     /codon_start=1
                     /gene="hybE"
                     /locus_tag="b2992"
                     /product="hydrogenase 2-specific chaperone"
                     /label=hybE
                     /note="HybE plays a role in coordinating assembly and
                     export of the |FRAME: FORMHYDROG2-CPLX| subunits HybO and 
                     HybC.  HybE physically interacts with Tat signal 
                     peptide-containing HybO |CITS: [12914940][19151138]| and 
                     HybC |CITS: [12914940]| precursor proteins, which are Tat 
                     export substrates.
                     A solution structure of HybE shows that the protein adopts 
                     a three-layer sandwich fold with a disordered C-terminal 
                     region |CITS: [19291739]|.
                     A <i>hybE</i> deletion strain has very low hydrogenase 2 
                     activity; in this strain, the HybO subunit is associated 
                     with the membrane, but HybC, although C-terminally 
                     processed, remains in the cytoplasm |CITS: [15385959]|. 
                     Reviews: |CITS: [15667278][17216401]|"
