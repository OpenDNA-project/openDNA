     gene            15445..16557
                     /gene="insL1"
                     /locus_tag="b0016"
                     /label=insL1
     CDS             15445..16557
                     /codon_start=1
                     /gene="insL1"
                     /locus_tag="b0016"
                     /product="IS186/IS421 family transposase"
                     /label=insL1
                     /note="IS186 is an insertion sequence element that appears
                     three times in a typical <i>E. coli</i> genome.
                     IS186 is an insertion sequence element with an apparent 
                     preference for GC-rich sequences |CITS: 
                     [2997142][2996940]|. As a consequence, it can insert at the
                     tail end of cDNA clones |CITS: [2996940]|. At the DNA 
                     level,
                     the various IS186 genes have terminal inverted repeats and 
                     produce variable-length DNA duplications at the insertion 
                     site (10, 12 or 13 bp) |CITS: [2997142][2996940]|."
                     /translation="MNYSHDNWSAILAHIGKPEELDTSARNAGALTRRREIRDAATLLR
                     LGLAYGPGGMSLREVTAWAQLHDVATLSDVALLKRLRNAADWFGILAAQTLAVRAAVTG
