     gene            2358033..2358458
                     /gene="nudI"
                     /locus_tag="b2251"
                     /label=nudI
     CDS             2358033..2358458
                     /codon_start=1
                     /gene="nudI"
                     /locus_tag="b2251"
                     /product="multifunctional pyrimidine deoxynucleotide
                     diphosphatase NudI / geranyl diphosphate phosphatase / dUTP
                     pyrophosphohydrolase / dTTP pyrophosphohydrolase / dCTP 
                     pyrophosphohydrolase"
                     /EC_number="3.6.1.68; 3.6.1.23; 3.6.1.12"
                     /label=nudI
                     /note="NudI is a member of the Nudix hydrolase superfamily
                     of nucleoside diphosphatases.  The preferred substrate of 
                     the purified enzyme is dUTP, but it also shows 67 and 58% 
                     of activity with dTTP and dCTP, respectively |CITS: 
                     [16766526]|.  A recent analysis showed that geranyl 
                     diphosphate is a better substrate than dUTP |CITS: 
                     [31173659]|.
                     The enzyme is a monomer in solution |CITS: [16766526]|. 
                     Preliminary crystallographic data for NudI from <i>E. 
                     coli</i> K-1 is available |CITS: [17768363]|.
                     In an effort to engineer novel biosynthetic pathways for 
                     5-carbon alcohols, it was shown that NudI has a low level 
                     of isopentenyl pyrophosphate phosphatase activity <i>in 
                     vitro</i>, producing the desired intermediate 
                     3-methyl-3-butenol |CITS: [22941086]|.  NudI can also 
                     dephosphorylate dimethylallyl pyrophosphate <i>in vitro</i>
                     |CITS: [29551348]|.
                     Review: |CITS: [16378245]|
                     "
                     /translation="MRQRTIVCPLIQNDGAYLLCKMADDRGVFPGQWAISGGGVEPGER
