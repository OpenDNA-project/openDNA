     CDS             complement(1407494..1407709)
                     /codon_start=1
                     /gene="xisR"
                     /locus_tag="b1346"
                     /product="Rac prophage; excisionase"
                     /label=xisR
                     /note="XisR is the excisionase of the Rac prophage.
                     Excision of Rac is induced during biofilm formation and 
                     during stationary phase |CITS: [26530864]|.
                     Deletion of <i>xisR</i> leads to reduced Rac excision, 
                     while overexpression increases Rac excision |CITS: 
                     [26530864]|.  Increased expression of <i>xisR</i> during 
                     stationary phase is RpoS-dependent |CITS: [26530864]|. 
                     XisR: ""e<b>x</b>c<b>is</b>ionase gene for <b>R</b>ac"" 
                     |CITS: [26530864]|"
                     /translation="MAQVIFNEEWMVEYGLMLRTGLGARQIEAYRQNCWVEGFHFKRVS
                     PLGKPDSKRGIIWYNYPKINQFIKDS"
                     /go_function="sequence-specific double-stranded DNA
                     binding [goid 1990837] [evidence IDA] [PMID 26530864]"
                     /go_process="provirus excision [goid 0032359] [evidence
                     IMP] [PMID 26530864]"
     gene            complement(1407788..1407997)
                     /gene="rcbA"
                     /locus_tag="b1347"
                     /label=rcbA
     CDS             complement(1407788..1407997)
                     /codon_start=1
                     /gene="rcbA"
                     /locus_tag="b1347"
                     /product="Rac prophage; double-strand break reduction
                     protein"
                     /label=rcbA
                     /note="An <i>rcbA</i> deletion mutant has an increased
                     level of chromosomal double strand breaks (DSB) |CITS: 
                     [22343303]|. Overexpression of <i>rcbA</i> from a plasmid 
                     suppresses the lethal effect caused by the induced 
                     expression of the chromosomal replication initiation 
                     protein, DnaA, in DSB repair-defective mutants |CITS: 
                     [22343303]|. Overproduction of DnaA is toxic in an 
                     <i>rcbA</i> deletion mutant but not in the isogenic 
                     <i>rcbA</i><sup>+</sup> strain |CITS: [22343303]|. The 
                     mechanism of action of RcbA is not clear.
                     Overexpression of <i>rcbA</i> increases fitness as well as 
                     resistance to toxic compounds and antibiotics, including 
                     erythromycin |CITS: [21173244]|.
                     It is possible that the RcbA phenotype is due to the 
                     expression of |FRAME: G0-16600 RalA|, a small RNA antitoxin
                     encoded on the opposite strand |CITS: [24748661]|.
                     <i>rcbA</i>: <U>r</U>educes the frequency of 
                     <U>c</U>hromosome <U>b</U>reaks |CITS: [22343303]|"
                     /translation="MYKITATIEKEGGTPTNWTRYSKSKLTKSECEKMLSGKKEAGVSR
                     EQKVKLINFNCEKLQSSRIALYSN"
                     /go_function="protein binding [goid 0005515] [evidence
                     IPI] [PMID 15690043]"
                     /go_process="response to antibiotic [goid 0046677]
                     [evidence IEA] [GO_REF 0000043]"
                     /go_process="DNA metabolic process [goid 0006259]
                     [evidence EXP] [PMID 22343303]"
                     /go_process="DNA metabolic process [goid 0006259]
                     [evidence IMP] [PMID 22343303]"
     gene            1407813..1407991
                     /gene="ralA"
                     /locus_tag="b4714"
                     /label=ralA
     misc_RNA        1407813..1407991
                     /gene="ralA"
                     /locus_tag="b4714"
                     /product="Rac prophage; small regulatory RNA antitoxin
                     RalA"
                     /note="RalA acts as the antitoxin of a type I
                     toxin-antitoxin system with RalR.  RalA RNA base-pairs with
                     the RalR mRNA, which may prevent translation of the RalR 
                     toxin.  Antitoxin activity of RalA is dependent on |FRAME: 
                     CPLX0-1461 Hfq|, and Hfq binds directly to RalA |CITS: 
                     [24748661]|.
                     In wild type cells, transcript levels of <i>ralA</i> are 
                     undetectable |CITS: [24748661]|.
                     RalA: ""<b>Ral</b>R <b>a</b>ntitoxin"" |CITS: [24748661]| 
                     Review: |CITS: [32213244]|"
     gene            complement(1407990..1408184)
                     /gene="ralR"
                     /locus_tag="b1348"
                     /label=ralR
     CDS             complement(1407990..1408184)
                     /codon_start=1
                     /gene="ralR"
                     /locus_tag="b1348"
                     /product="bifunctional Rac prophage; endodeoxyribonuclease
                     toxin RalR / DNA endonuclease"
                     /label=ralR
                     /note="RalR (Lar) is the toxin of the RalRA type I 
                     toxin-antitoxin system.  RalR is a non-specific DNA 
                     endonuclease that cleaves both methylated and unmethylated 
                     DNA.  A RalR mutant with reduced toxicity also has lost 
                     endonuclease activity |CITS: [24748661]|.
                     Overexpression of RalR inhibits growth.  In the presence of
                     the small RNA RalA, the level of RalR protein expressed 
                     from a plasmid is decreased |CITS: [24748661]|.
                     Growth of a &Delta;<i>ralR</i> or &Delta;<i>ralRA</i> 
                     mutant is more severely inhibited by fosfomycin than wild 
                     type |CITS: [24748661]|.
                     <i>ralR</i> is part of the lambdoid prophage Rac.  It was 
                     shown to be involved in restriction alleviation and 
                     enhancement of modification by EcoKI (a type I 
                     restriction/modification system) |CITS: 
                     [4562392][6264133][7476171][16677300]|, but not in 
                     restriction alleviation of type III restriction systems 
                     |CITS: [16237019]|.
                     RalR (Lar) and the phage &lambda; Ral protein show 25% 
                     sequence identity |CITS: [7476171]|.
                     "
                     /translation="MRYDNVKPCPFCGCPSVTVKAISGYYRAKCNGCESRTGYGGSEKE
                     ALERWNKRTTGNNNGGVHV"
