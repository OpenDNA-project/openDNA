     gene            4002530..4003552
                     /gene="pldB"
                     /locus_tag="b3825"
                     /label=pldB
     CDS             4002530..4003552
                     /codon_start=1
                     /gene="pldB"
                     /locus_tag="b3825"
                     /product="multifunctional lysophospholipase L2 / 2-acyl 
                     lysophospholipase / 1-acyl lysophospholipase / 
                     glycerophosphoglycerol acyltransferase"
                     /label=pldB
                     /note="Lysophospholipase L2 (PldB) hydrolyzes the
                     acyl-ester bond of acyl-lysophospholipids. The most 
                     effective substrates of the purified enzyme <i>in vitro</i>
                     are 2-acyl glycerophosphoethanolamine and 2-acyl 
                     glycerophosphocholine; the 1-acyl versions of each compound
                     are hydrolyzed somewhat less effectively. Purified PldB can
                     also transfer an acyl group from acyl-lysophospholipids to 
                     phosphatidylglycerol to yield acyl phosphatidylglycerol; 
                     the enzyme is more active with 2-acyl donors (2-acyl 
                     glycerophosphoethanolamine and 2-acyl 
                     glycerophosphocholine) than 1-acyl donors |CITS: 
                     [3908447]|.
                     PldB does not contain an obvious signal sequence or 
                     transmembrane domain and is thought to be associated with 
                     the cytoplasmic side of the inner membrane |CITS: 
                     [3908445][3908447]|.
                     Mutants with altered lysophospholipase activity have been 
                     isolated |CITS: [6386795]|.
                     PldB: ""<b>p</b>hospho<b>l</b>ipid <b>d</b>egradation 
                     <b>B</b>"" |CITS: [6368530]|"
