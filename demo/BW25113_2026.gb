     gene            3775224..3775616
                     /gene="cysX"
                     /locus_tag="b4747"
                     /label=cysX
                     /note="This <i>cysX</i> gene sequence was found to be
                     entirely inside the |FRAME: EG10187| gene in the opposite 
                     position and then expressed <i>in vivo</i> as a beta-gal 
                     fusion |CITS: [2108679]|. An entry for this gene can be 
                     found in UniProtKB entry <A href=""https://www.uniprot.org 
                     /uniprotkb/P20343/entry"">P20343</A>. This gene has been 
                     made a phantom gene after discussion as to whether it is a 
                     true gene in <i>E. coli</i>. No studies were found 
                     following up from Tei et al. 1990; only a few other papers 
                     cite it and only briefly note <i>cysX</i> with no 
                     additional information (for instance |CITS: [26443742]|). 
                     The <i>cysX</i> orf appeared in Kenn Rudd's EcoMap5 |CITS: 
                     [1312707]| and EcoMap6 |CITS: [8393935]| but was no longer 
                     listed in EcoMap7 |CITS: [BERLYN96]|. It is worth noting 
                     that <i>cysX</i> coding sequence is conserved in some other
                     Enterobacteraceae, such as <i>E. albertii</i> and 
                     <i>Shigella</i>, but many other organisms have a stop codon
                     at position 7, such as <i>Salmonella</i> and 
                     <i>Citrobacter</i> (personal communication with Guy 
                     Plunkett III, Eric Neeno-Eckwall and Andrea Auchincloss)."
                     /note="/phantom"
     gene            complement(3776002..3777021)
                     /gene="gpsA"
                     /locus_tag="b3608"
                     /label=gpsA
     CDS             complement(3776002..3777021)
                     /codon_start=1
                     /gene="gpsA"
                     /locus_tag="b3608"
                     /product="bifunctional glycerol-3-phosphate dehydrogenase, 
                     biosynthetic / glycerol-3-phosphate dehydrogenase"
                     /EC_number="1.1.1.94"
                     /label=gpsA
                     /note="Glycerol-3-phosphate dehydrogenase (GpsA) catalyzes
                     the NAD(P)H-dependent reduction of the glycolytic 
                     intermediate dihydroxyacetone-phosphate to produce 
                     glycerol-3-phosphate, a precursor for the biosynthesis of 
                     phospholipids |CITS: [4914567][4591941][4597451][368067]|. 
                     GpsA activity is strongly inhibited <i>in vitro</i> by 
                     glycerol-3-phosphate, and it was shown that this inhibition
                     does not involve dimer association or dissociation.  A 
                     mutant version of the protein which is resistant to 
                     feedback inhibition has been studied |CITS: [240817]|.
                     The enzyme is constitutively produced, and is present in 
                     the cell in low amounts.  It was calculated that on average
                     only about 1000 molecules are present per cell |CITS: 
                     [355254]|.
                     GpsA did not show dehydrogenase activity in a 
                     high-throughput screen of purified proteins |CITS: 
                     [15808744]|.
                     "
