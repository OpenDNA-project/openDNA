     gene            complement(1154818..1157007)
                     /gene="fhuE"
                     /locus_tag="b1102"
                     /label=fhuE
     CDS             complement(1154818..1157007)
                     /codon_start=1
                     /gene="fhuE"
                     /locus_tag="b1102"
                     /product="trifunctional ferric coprogen/ferric
                     rhodotorulic acid outer membrane transporter / ferric 
                     coprogen outer membrane transport complex / transport of 
                     ferric coprogen"
                     /label=fhuE
                     /note="FhuE is a protein which serves as a receptor for 
                     ferric-coprogen (a hydroxamate-type iron chelator) and 
                     ferric-rhodotorulic acid |CITS: [3032906]|. Uptake into the
                     periplasm is facilitated by TonB coupling of inner membrane
                     energy to power specific uptake across the outer membrane 
                     |CITS: [7830717]|. Coprogen iron uptake is dependent on 
                     <i>tonB, exbB and fhuCDB</I> |CITS: [6353165]|. FhuE 
                     appears to have a preference for &Delta;-absolute 
                     configuration metal complexes |CITS: [6234892]|.
                     In the Transporter Classification Database FhuE is a member
                     of the Outer Membrane Receptor (OMR) family |CITS: 
                     [26546518]|"
