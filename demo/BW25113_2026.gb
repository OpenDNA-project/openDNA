     gene            complement(3846250..3846348)
                     /gene="ivbL"
                     /locus_tag="b3672"
                     /label=ivbL
     CDS             complement(3846250..3846348)
                     /codon_start=1
                     /gene="ivbL"
                     /locus_tag="b3672"
                     /product="ilvBN operon leader peptide"
                     /label=ivbL
                     /note="The <i>ilvBN</i> operon leader peptide (IvbL)
                     controls by attenuation the expression of the |FRAME: 
                     TU00032| operon, which codes for an enzyme involved in 
                     isoleucine and valine biosynthesis. The attenuator region 
                     contains both valine and leucine residues and several 
                     potential stem-loop structures, yielding negative 
                     regulation in response to valine and leucine levels. It 
                     also contains regions similar to those found in 
                     CRP-dependent promoters, yielding positive regulation in 
                     response to cyclic AMP and CRP |CITS: [6292893]|."
                     /translation="MTTSMLNAKLLPTAPSAAVVVVRVVVVVGNAP"
                     /go_component="cytosol [goid 0005829] [evidence IEA] [PMID
                     19054114]"
