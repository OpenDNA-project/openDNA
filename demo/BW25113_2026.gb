     gene            complement(1337367..1337585)
                     /gene="osmB"
                     /locus_tag="b1283"
                     /label=osmB
     CDS             complement(1337367..1337585)
                     /codon_start=1
                     /gene="osmB"
                     /locus_tag="b1283"
                     /product="osmotically-inducible lipoprotein OsmB"
                     /label=osmB
                     /note="<I>osmB</I> encodes an outer membrane lipoprotein 
                     |CITS:[2644204]|. An <i>osmB</i>::Tn<i>phoA</i> fusion is 
                     induced after growth in a medium of high osmolarity (0.3 M 
                     NaCl or 0.6 M sucrose) |CITS: [2821274]|. <i>osmB</i> 
                     transcription is induced in response to hyperosmolarity or 
                     upon entry into stationary phase |CITS: [1693921]| (see 
                     also |CITS: [1744047][7476160]|). <i>osmB</i> transcription
                     increases following activation of the |FRAME: PWY0-1493 
                     ""RcsCDB phosphorelay|; <i>osmB</i> belongs to the 
                     RcsA-independent subfamily of RcsB targets |CITS: 
                     [15838058]| (see also |CITS: [7476160][14651646]|). OsmB 
                     plays a role in protection against the <i>Vibrio 
                     cholerae</i> type 6 secretion system effector, TseH |CITS: 
                     [32094588]|
                     <i>osmB</i>: <U>osm</U>o-inducible gene B |CITS: 
                     [2821274]|.
                     "
                     /translation="MFVTSKKMTAAVLAITLAMSLSACSNWSKRDRNTAIGAGAGALGG
                     AVLTDGSTLGTLGGAAVGGVIGHQVGK"
