     gene            complement(3997590..3998057)
                     /gene="yigI"
                     /locus_tag="b3820"
                     /label=yigI
     CDS             complement(3997590..3998057)
                     /codon_start=1
                     /gene="yigI"
                     /locus_tag="b3820"
                     /product="acyl-CoA thioesterase YigI"
                     /EC_number="3.1.2.2; 3.1.2.20"
                     /label=yigI
                     /note="This cytosolic acyl-CoA thioesterase is involved in 
                     thioesterase-dependent &beta;-oxidation of fatty acids in 
                     <i>E. coli</i>  |CITS: [35876515]|. It participates in the 
                     degradation of conjugated linoleic acid (CLA), overlapping 
                     in its substrate specificities with two other cytosolic 
                     thioesterases in <i>E. coli</i>, |FRAME: EG10995| and 
                     |FRAME: G6244|; the three genes differ in the conditions 
                     under which they are expressed |CITS: 
                     [18702504][35876515]|.
                     Computational prediction of its structure shows high 
                     sequence similarity and structural alignment with a 
                     thioesterase from |FRAME: TAX-70863| including a hot-dog 
                     fold characteristic of thioesterases |CITS: [35876515]|. 
                     Mutation studies indicate that YigI cleaves medium- to 
                     long-chain acyl-CoA derivatives, including conjugated 
                     linoleic acid (CLA; |FRAME: 
                     9-CIS11-TRANS-OCTADECADIENOATE|) as the sole source of 
                     carbon, though at a reduced growth rate |CITS: 
                     [35876515]|."
