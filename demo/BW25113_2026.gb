     gene            complement(4232459..4232561)
                     /gene="malH"
                     /locus_tag="b4807"
                     /label=malH
     misc_RNA        complement(4232459..4232561)
                     /gene="malH"
                     /locus_tag="b4807"
                     /product="small regulatory RNA MalH"
                     /note="MalH is a small RNA generated as a degradation 
                     intermediate from the 3' end and UTR of <i>malG</i> |CITS: 
                     [33043783]|.  The Hfq-dependent MalH and 38 potential 
                     targets were also identified by applying a small RNA 
                     prediction algorithm to RIL-seq data |CITS: [34093460]|. 
                     MalH is expressed during the transition from exponential to
                     stationary phase |CITS: [33043783][34093460]|. 
                     Overexpression of MalH leads to downregulation of a set of 
                     RNAs including MicA, <i>ompC</i>, <i>ompA</i>, <i>rseA</i>,
                     and <i>ptsH</i>; conversely, mutations in the MalH seed 
                     sequence decrease <i>lamB</i> expression |CITS: 
                     [33043783]|."
     gene            complement(4232554..4233444)
