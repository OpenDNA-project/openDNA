     gene            2027130..2027220
                     /gene="rseX"
                     /locus_tag="b4603"
                     /label=rseX
     misc_RNA        2027130..2027220
                     /gene="rseX"
                     /locus_tag="b4603"
                     /product="small regulatory RNA RseX"
                     /note="The small RNA RseX targets the <i>ompA</i> and 
                     <i>ompC</i> mRNAs and reduces their levels in the cell. The
                     RNA-binding protein Hfq binds to RseX and is required for 
                     the activity of RseX |CITS: [16513633]|.  Additional 
                     potential regulatory targets of RseX were predicted, and 
                     regulation of <i>fimB</i> and <i>ihfB</i> was confirmed 
                     experimentally |CITS: [34327153]|.
                     RseX was identified as a multicopy suppressor that enables 
                     survival of depletion of the essential RIP protease RseP. 
                     In the absence of both OmpA and OmpC, the targets of RseX, 
                     RseP is not essential for survival.  RseX also acts as a 
                     suppressor of a <i>degS</i> mutation, but it does not 
                     restore &sigma;<sup>E</sup> activity |CITS: [16513633]|. 
                     Overexpression of RseX increases biofilm formation and 
                     decreases swarming motility and curli expression |CITS: 
                     [26469694]|.  The existence of RseX was predicted 
                     computationally, but ""IS096"" could not be detected by 
                     Northern analysis |CITS: [12069726]|.  RseX is expressed in
                     a &Delta;<i>hns</i> mutant beginning at the transition to 
                     stationary phase |CITS: [34327153]|.
                     RseX: ""<b>R</b>NA <b>s</b>uppressor of 
                     <b>ex</b>tracytoplasmic stress protease"" |CITS: 
                     [16513633]|
                     Reviews: |CITS: [17055775][20068355][32213244]|"
     gene            2027532..2028724
                     /pseudo
                     /gene="yedS"
                     /locus_tag="b4496"
                     /label=yedS
     CDS             join(2027532..2028194,2028194..2028724)
                     /pseudo
