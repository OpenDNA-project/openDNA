     gene            complement(2952419..2955787)
                     /gene="recC"
                     /locus_tag="b2822"
                     /label=recC
     CDS             complement(2952419..2955787)
                     /codon_start=1
                     /gene="recC"
                     /locus_tag="b2822"
                     /product="bifunctional exodeoxyribonuclease V subunit RecC
                     / exodeoxyribonuclease V"
                     /EC_number="3.1.11.5"
                     /label=recC
                     /note="RecC is one of three proteins of the heterotrimeric 
                     helicase/nuclease complex known as Exonuclease V or RecBCD 
                     that promotes homologous recombination in the repair of 
                     double-strand DNA breaks and during bacterial conjugation. 
                     Over-expressed, purified RecC has no exonuclease activity 
                     but when combined together, purified RecC and RecB exhibit 
                     ATP-dependent exonuclease activity on dsDNA |CITS: 
                     [3155726]|.
                     The SOS response proteins, RecA and RecC, are targets for 
                     ciprofloxacin helper drugs |CITS:[30013537]|.
                     <i>recC</i> belongs to a network of genes which facilitate 
                     stress-induced mutagenesis (SIM) in <i>E. coli</i> K-12 
                     |CITS: [23224554]|."
