     gene            1211245..1211481
                     /gene="ycgZ"
                     /locus_tag="b1164"
                     /label=ycgZ
     CDS             1211245..1211481
                     /codon_start=1
                     /gene="ycgZ"
                     /locus_tag="b1164"
                     /product="putative two-component system connector protein
                     YcgZ"
                     /label=ycgZ
                     /note="Overexpression of <i>ycgZ</i> increases fitness as
                     well as resistance to several antibiotics, including 
                     aztreonam and cefuroxime |CITS: [21173244]| and decreases 
                     transcription of <i>ompF</i> |CITS: [28713335]|. YcgZ 
                     appears to partially antagonize the effect of YmgA and AriR
                     on mucoidy and curli expression |CITS: [19240136]|. YcgZ is
                     a substrate of the Lon protease |CITS: [28713335]|.
                     Temperature-dependent expression of <i>ycgZ</i> is 
                     regulated by the repressor BluR |CITS: 
                     [19240136][28713335]| and the alternative sigma factor RpoS
                     |CITS: [15716429][19240136]| as well as by MarA |CITS: 
                     [31518447]|. <i>ycgZ</i> is a member of the cold shock 
                     stimulon |CITS: [14527658][18174134]|.
                     <i>yhdV</i> was in the top 20 genes with increased 
                     translation in response to extreme acid stress (pH 4.4 
                     compared to pH 7.6) as measured by ribosome coverage of its
                     transcripts using RNA-Seq |CITS: [37909716]|."
                     /translation="MHQNSVTLDSAGAITRYFAKANLHTQQETLGEIVTEILKDGRNLS
                     RKSLCAKLLCRLEHATGEEEQKHYNALIGLLFE"
                     /go_function="protein binding [goid 0005515] [evidence
                     IPI] [PMID 31518447]"
                     /go_process="cellular response to acidic pH [goid 0071468]
                     [evidence EXP] [PMID 37909716]"
                     /go_process="cellular response to acidic pH [goid 0071468]
                     [evidence IEA] [GO_REF 0000002]"
                     /go_process="negative regulation of DNA-templated
                     transcription [goid 0045892] [evidence IMP] [PMID 
                     28713335]"
     gene            1211524..1211796
                     /gene="ymgA"
                     /locus_tag="b1165"
                     /label=ymgA
     CDS             1211524..1211796
                     /codon_start=1
                     /gene="ymgA"
                     /locus_tag="b1165"
                     /product="putative two-component system connector protein
                     YmgA"
                     /label=ymgA
                     /note="Deletion of <i>ymgA</i> increases biofilm formation
                     and motility |CITS: [17765265][18344336]|.  When placed on 
                     a low copy number plasmid at low temperature, <i>ymgA</i> 
                     increases production of capsule material and reduces 
                     expression of curli |CITS: [19240136]|.
                     Expression of <i>ymgA</i> is regulated under conditions of 
                     biofilm formation.  The presence of AI-2 |CITS: [15470704]|
                     or the stationary phase biofilm signal indole |CITS: 
                     [17511876]| repress <i>ymgA</i> expression. <i>ymgA</i> is 
                     repressed in young and mature biofilms, but is induced in 
                     the intermediate, developed biofilms |CITS: [17222132]|, by
                     rapid acid treatment |CITS: [18302792]| and under low 
                     temperature growth conditions |CITS: [18174134]|.  
                     Expression of <i>ymgA</i> is regulated by the repressor 
                     BluR |CITS: [19240136]| and the alternative sigma factor 
                     RpoS |CITS: [15716429][19240136]| as well as by MarA |CITS:
                     [31518447]|."
                     /translation="MKTSDNERIKYEITGQAVLQILRMKINFSLQTLIKQLLVMKSAEE
                     DAFRRDLIDSIIRDFSNSDSGGPNRRTATADNKSMFNGKKINRIH"
                     /go_function="protein binding [goid 0005515] [evidence
                     IPI] [PMID 31518447]"
                     /go_process="negative regulation of single-species biofilm
                     formation [goid 1900191] [evidence IMP] [PMID 17765265]"
     gene            1211825..1212091
                     /gene="ariR"
                     /locus_tag="b1166"
                     /label=ariR
     CDS             1211825..1212091
                     /codon_start=1
                     /gene="ariR"
                     /locus_tag="b1166"
                     /product="putative two-component system connector protein
                     AriR"
                     /label=ariR
                     /note="AriR appears to be a regulator of acid resistance
                     and biofilm formation.  AriR binds DNA, and <i>in vivo</i> 
                     target sites were identified by nickel-enrichment DNA 
                     microarray studies.  <i>In vitro</i>, AriR binds DNA 
                     non-specifically |CITS: [17765265]|.  Acting via AriR, 
                     5-fluorouracil inhibits biofilm formation |CITS: 
                     [19172264]|.
                     The crystal structure of a C-terminal proteolytic fragment 
                     of AriR has been solved at 1.8 &Aring; resolution; despite 
                     very low sequence identity, the protein is structurally 
                     homologous to the regulatory protein Hha |CITS: 
                     [17765265]|.
                     Expression of <i>ariR</i> is regulated under conditions of 
                     biofilm formation.  Deletion of <i>tqsA</i> (encoding the 
                     AI-2 transporter) |CITS: [16385049]| and the presence of 
                     AI-2 |CITS: [15470704]| or the stationary phase biofilm 
                     signal indole |CITS: [17511876]| repress <i>ariR</i> 
                     expression.  <i>ariR</i> is repressed in young and mature 
                     biofilms, but is induced in the intermediate, developed 
                     biofilms |CITS: [17222132]|, by rapid acid treatment |CITS:
                     [18302792]| and under low temperature growth conditions 
                     |CITS: [18174134]|.  Expression of <i>ariR</i> is regulated
                     by the repressor BluR |CITS: [19240136]| and the 
                     alternative sigma factor RpoS |CITS: [15716429][19240136]|.
                     When placed on a low copy number plasmid, <i>ariR</i> 
                     increases production of capsule material and reduces 
                     expression of curli; AriR appears to modulate the activity 
                     of the Rcs two-component signaling pathway |CITS: 
                     [19240136]|.  AriR was found to interact with the 
                     cytoplasmic histidine kinase domain of RcsC |CITS: 
                     [31518447]|.
                     Deletion of <i>ariR</i> increases biofilm formation and 
                     motility, reduces acid resistance |CITS: [17765265]|, and 
                     increases tolerance to benzoate and salicylate |CITS: 
                     [31175192]|.  The defect in acid resistance is not 
                     complemented by overexpression of <i>ariR</i> |CITS: 
                     [17765265]|.
                     AriR: ""<b>r</b>egulator of <b>a</b>cid <b>r</b>esistance 
                     influenced by <b>i</b>ndole"" |CITS: [17765265]|"
                     /translation="MLEDTTIHNAITDKALASYFRSSGNLLEEESAVLGQAVTNLMLSG
                     DNVNNKNIILSLIHSLETTSDILKADVIRKTLEIVLRYTADDM"
