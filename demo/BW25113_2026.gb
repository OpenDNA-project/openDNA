     gene            complement(1995591..1997087)
                     /gene="fliC"
                     /locus_tag="b1923"
                     /label=fliC
     CDS             complement(1995591..1997087)
                     /codon_start=1
                     /gene="fliC"
                     /locus_tag="b1923"
                     /product="bifunctional flagellar filament structural
                     protein / flagellum"
                     /label=fliC
                     /note="FliC, or flagellin, is the basic subunit that
                     polymerizes to form the rigid flagellar filament of 
                     <I>Escherichia coli</I>.
                     <i>fliC</i> was found upregulated in two MG1655 lysogens 
                     carrying closely related Stx2a phages O104 and PA8 |CITS: 
                     31208335|.
                     For a description of flagellar gene nomenclature, including
                     old (<i>fla, flb</I>) and new (<i>flg, flh</i> and 
                     <i>fli</i>) symbols, see |CITS: [3070322]|.
                     The 'pole-localizer' protein |FRAME: G7087-MONOMER TmaR| 
                     protects and stabilizes <i>fliA</i> transcripts |CITS: 
                     [37934665]|."
                     /translation="MAQVINTNSLSLITQNNINKNQSALSSSIERLSSGLRINSAKDDA
                     AGQAIANRFTSNIKGLTQAARNANDGISVAQTTEGALSEINNNLQRVRELTVQATTGTN
                     SESDLSSIQDEIKSRLDEIDRVSGQTQFNGVNVLAKNGSMKIQVGANDNQTITIDLKQI
                     DAKTLGLDGFSVKNNDTVTTSAPVTAFGATTTNNIKLTGITLSTEAATDTGGTNPASIE
