     gene            complement(2967214..2969373)
                     /gene="aas"
                     /locus_tag="b2836"
                     /label=aas
     CDS             complement(2967214..2969373)
                     /codon_start=1
                     /gene="aas"
                     /locus_tag="b2836"
                     /product="multifunctional fused
                     2-acylglycerophosphoethanolamine acyltransferase/acyl-acyl 
                     carrier protein synthetase / octanoyl-ACP synthetase / 
                     2-acylglycerophosphoethanolamine acyltransferase / acyl-ACP
                     synthetase"
                     /EC_number="6.2.1.47; 2.3.1.40"
                     /label=aas
                     /note="2-acylglycerophosphoethanolamine (2-acyl-GPE) 
                     acyltransferase and acyl-acyl carrier protein (acyl-ACP) 
                     synthetase are dual catalytic activities encoded by the 
                     <i>aas</i> gene. Both enzymatic activities participate in 
                     membrane phospholipid turnover and the uptake and 
                     incorporation of exogenous 2-acyllysophospholipids. The 
                     function of 2-acyl-GPE acyltransferase is to regenerate 
                     phosphatidylethanolamine (PtdEtn) from 2-acyl-GPE formed by
                     transacylation reactions or phospholipase A1 action. In the
                     process enzyme-bound ACP is also regenerated |CITS: 
                     [8300626][1649829]|.
                     Acyl-ACP synthetase functions to ligate free fatty acids, 
                     with lengths of C-8 to C-18, to ACP |CITS: 
                     [8300626][1649829][378999]|.
                     The protein contains bound ACP |CITS: [1649829][2540190]|. 
                     Based on sequence similarity, Aas has been predicted to be 
                     a hydroxycinnamate-CoA ligase |CITS: [12952533]|.
                     Review: |CITS: [37345808]|"
