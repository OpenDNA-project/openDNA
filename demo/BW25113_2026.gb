     gene            complement(2293746..2296232)
                     /gene="napA"
                     /locus_tag="b2206"
                     /label=napA
     CDS             complement(2293746..2296232)
                     /codon_start=1
                     /gene="napA"
                     /locus_tag="b2206"
                     /product="trifunctional periplasmic nitrate reductase
                     subunit NapA / periplasmic nitrate reductase / nitrate 
                     reductase (cytochrome)"
                     /EC_number="1.9.6.1"
                     /label=napA
                     /note="The |FRAME: EG12067| gene encodes the
                     molybdoprotein subunit of the periplasmic nitrate reductase
                     |CITS: [8830238] [8919448]|.  NapA is synthesized as a 
                     precursor with a 36 residue signal peptide that is removed 
                     upon export to the periplasm |CITS: [10234835]|.  It binds 
                     a |FRAME: CPD-7 ""[4Fe-4S]""| cluster and |FRAME: CPD-582| 
                     |CITS: [17130127]|.
                     Prior to export the signal peptide of NapA is bound to the 
                     |FRAME: EG12143 NapD| chaperon, preventing premature 
                     export.  In the absence of NapD, NapA is unstable and is 
                     degraded |CITS: [10548535][17901208][19151138]|.
                     A NapD binding epitope is located towards the N-terminus of
                     the NapA signal peptide and partially overlaps with a twin 
                     arginine motif |CITS: [22329966]|. An NMR structure of the 
                     NapD-NapA signal peptide complex has been reported |CITS: 
                     [22329966]|."
