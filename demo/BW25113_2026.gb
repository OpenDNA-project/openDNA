     gene            complement(1631866..1632039)
                     /gene="gnsB"
                     /locus_tag="b1550"
                     /label=gnsB
     CDS             complement(1631866..1632039)
                     /codon_start=1
                     /gene="gnsB"
                     /locus_tag="b1550"
                     /product="Qin prophage; protein GnsB"
                     /label=gnsB
                     /note="GnsB and its homolog |FRAME: MONOMER0-1701 GnsA|
                     affect unsaturated fatty acid abundance and membrane 
                     fluidity |CITS: [11544213]|.
                     Multicopy expression of <i>gnsA</i> or <i>gnsB</i> 
                     suppresses <i>secG</i> null or <i>fabA6</i> mutant growth 
                     phenotypes. GnsA and GnsB overproduction causes greater 
                     abundance of unsaturated fatty acids in a <i>secG</i> 
                     mutant background and results in phenotypes consistent with
                     greater membrane fluidity. A <i>gnsA gnsB</i> double mutant
                     does not exhibit any obvious growth phenotypes |CITS: 
                     [11544213]|. GnsB and GnsA are also able to rescue the 
                     growth defect and to restore the relative proportion of 
                     unsaturated to saturated fatty acids in various 
                     (p)ppGpp-deficient strains (e.g. deletion mutants of 
                     |FRAME: EG10281|, |FRAME: EG10835| and |FRAME: EG10966|) at
                     low temperatures |CITS: [39461000]|.
                     GnsA and GnsB are not subject to cold shock regulation. 
                     Wild-type expression of GnsB is below the limit of 
                     detection |CITS: [11544213]|.
                     GnsB: ""<i>sec<b>G</b></i> null mutant <b>s</b>uppressor 
                     <b>B</b>"" |CITS: [11544213]|"
                     /translation="MNIENLKTKAEADISEYITKKIIELKKKTGKEVTSIQFTAREKMT
                     GLESYDVKINLI"
                     /go_component="cytosol [goid 0005829] [evidence IDA] [PMID
                     18304323]"
                     /go_process="unsaturated fatty acid biosynthetic process
                     [goid 0006636] [evidence EXP] [PMID 11544213]"
