     CDS             3822305..3823696
                     /codon_start=1
                     /gene="xanP"
                     /locus_tag="b3654"
                     /product="xanthine:H(+) symporter XanP"
                     /label=xanP
                     /note="The XanP protein (formerly YicE) is a member of the
                     NCS2 (Nucleobase-Cation Symport-2) family of transporters. 
                     XanP is a specific, high-affinity, proton motive 
                     force-dependent xanthine transporter with a Km of 2.9 to 
                     3.8 &mu;M
                     |CITS:[16096267]|. XanP is unable to transport guanine, 
                     hypoxanthine, uric acid, and uracil, or to
                     efficiently recognize certain xanthine or uric acid 
                     analogues |CITS:[16096267]|.
                     "
