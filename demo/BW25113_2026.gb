     gene            complement(1792216..1793199)
                     /gene="pheS"
                     /locus_tag="b1714"
                     /label=pheS
     CDS             complement(1792216..1793199)
                     /codon_start=1
                     /gene="pheS"
                     /locus_tag="b1714"
                     /product="trifunctional L-tyrosine--tRNA(Phe) ligase / 
                     L-tyrosyl-[tRNA(Phe)] deacylase / phenylalanine--tRNA 
                     ligase"
                     /EC_number="6.1.1.20"
                     /label=pheS
                     /note="The &alpha; subunit of PheRS (also called PheTS)
                     contains the phenylalanine binding site |CITS: 
                     [1104359][7043240]| within the conserved motif 2 and motif 
                     3 of the protein |CITS: [1942071][1959653]|. It interacts 
                     with the 3'-adenosine of tRNA<sup>Phe</sup> |CITS: 
                     [2823880]|.
                     Isolated &alpha; subunits exist primarily as dimers |CITS: 
                     [1915899]|.
                     The <i>pheS5</i> mutant allele (leading to a G98D change in
                     amino acid sequence) causes temperature-sensitive PheRS 
                     activity |CITS: [14273649][1537809]|. Intragenic supressors
                     of the <i>pheS5</i> mutation have been isolated and 
                     analyzed |CITS: [24811065]|. The temperature-sensitive 
                     <i>fitA76</i> and <i>fit95</i> mutants related to 
                     <i>pheS</i> and <i>pheT</i>, respectively, have been 
                     genetically characterized |CITS: 
                     [39316172][39419865][40095216][40304830][40464810]|.
                     There is a general discrepancy between k<sub>cat</sub> 
                     values of aminoacyl-tRNA synthetases that were measured 
                     <i>in vitro</i> and values that were calculated as needed 
                     to support measured growth rates |CITS: [6373741]|. 
                     Modeling of these parameters in <i>E. coli</i> has found 
                     that the required k<sub>cat</sub> values are on average 
                     7.6-fold higher than those measured <i>in vitro</i> |CITS: 
                     [37224536]|.
                     Reviews: |CITS: [JAYARAMAN1994]|"
