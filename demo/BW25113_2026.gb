     gene            4429404..4429610
                     /gene="ytfK"
                     /locus_tag="b4217"
                     /label=ytfK
     CDS             4429404..4429610
                     /codon_start=1
                     /gene="ytfK"
                     /locus_tag="b4217"
                     /product="stringent response modulator YtfK"
                     /label=ytfK
                     /note="YtfK has been shown to play a role in the stringent 
                     response under phosphate and fatty acid starvation 
                     conditions.  YtfK interacts with the catalytic domains of 
                     the bifunctional (p)ppGpp synthetase/hydrolase |FRAME: 
                     SPOT-MONOMER SpoT| and may thus activate the stringent 
                     response by increasing SpoT's (p)ppGpp synthetase activity 
                     |CITS: [31848343]|.
                     During phosphate and fatty acid starvation, a 
                     &Delta;<i>ytfK</i> mutant shows decreased accumulation of 
                     (p)ppGpp compared to wild type.  A P42L mutant does not 
                     interact with SpoT and does not increase (p)ppGpp 
                     accumulation upon overexpression |CITS: [31848343]|.
                     YtfK appears to play a role in tolerance to 
                     H<sub>2</sub>O<sub>2</sub> exposure and phosphate 
                     starvation |CITS: [29148366]|.
                     Expression of <i>ytfK</i> is activated by PhoB |CITS: 
                     [17020555]|.  YtfK levels are increased during phosphate 
                     and fatty acid starvation.  Overexpression of <i>ytfK</i> 
                     suppresses the growth defect of a &Delta;<i>relA</i> mutant
                     on SMG medium; suppression is <i>spoT</i>-dependent |CITS: 
                     [31848343]|."
                     /translation="MKIFQRYNPLQVAKYVKILFRGRLYIKDVGAFEFDKGKILIPKVK
                     DKLHLSVMSEVNRQVMRLQTEMA"
                     /go_function="protein binding [goid 0005515] [evidence
                     IPI] [PMID 31848343]"
                     /go_process="cellular response to phosphate starvation
                     [goid 0016036] [evidence IEP] [PMID 31848343]"
                     /go_process="stringent response [goid 0015968] [evidence
                     IGI] [PMID 31848343]"
                     /go_process="stringent response [goid 0015968] [evidence
                     IGI] [PMID 31848343]"
