     gene            4533491..4533525
                     /gene="fimR2"
                     /locus_tag="b4838"
                     /label=fimR2
     misc_RNA        4533491..4533525
                     /gene="fimR2"
                     /locus_tag="b4838"
                     /product="small regulatory RNA FimR2"
                     /note="Derived from the 3' UTR of <i>fimA</i> mRNA, FimR2
                     is a small RNA which regulates various phenotypes (biofilm 
                     formation, cell morphology, motility) that are important in
                     stationary phase growth; FimR2 has a dual mode of function 
                     - it regulates a diverse range of transcripts through 
                     direct base-pairing and it also sequesters the global 
                     regulator |FRAME: CPLX0-7956 Csr| |CITS: [36354005]|.
                     FimR2 accumulates in stationary phase via |FRAME: 
                     CPLX0-3461 RNaseE|-dependent cleavage of the 
                     <i>fimAICDFG</i> transcript |CITS: [36354005]|.
                     FimR2 is conserved across <i>E. coli</i> strains and within
                     enteric bacteria, and is likely important for virulence in 
                     pathogenic species |CITS: [36354005]|. <i>fimR2</i>: fim 
                     operon-derived sRNA |CITS: [36354005]|"
