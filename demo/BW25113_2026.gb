     misc_RNA        4569652..4569728
                     /gene="symR"
                     /locus_tag="b4625"
                     /product="small regulatory RNA antitoxin SymR"
                     /note="SymR is a very stable small RNA that is encoded on
                     the opposite strand of the <i>symE</i> 5' UTR and represses
                     translation of <i>symE</i>.  This effect does not appear to
                     require either Hfq or RNase III |CITS: [17462020]|.
                     SymR (RyjC) was identified in a cloning-based screen for 
                     small RNAs.  SymR is expressed under all tested growth 
                     conditions and after SOS induction |CITS: [15718303]|. 
                     SymR: ""<b>sym</b>biotic <b>R</b>NA"" |CITS: [17462020]| 
                     Reviews: |CITS: [17376733][23131729][32213244]|"
