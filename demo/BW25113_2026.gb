     gene            249954..250220
                     /pseudo
                     /gene="ykfJ"
                     /locus_tag="b0235"
                     /label=ykfJ
     CDS             249954..250220
                     /pseudo
                     /gene="ykfJ"
                     /locus_tag="b0235"
                     /product="RNA ligase superfamily protein YkfJ"
                     /label=ykfJ
                     /note="Based on the orthologous region in other sequenced 
                     bacterial genomes, a deletion event appears to have removed
                     approximately 1000 bp, encompassing the 3' end of 
                     <i>ykfJ</i> and the 5' end of <i>prfH</i>.  Thus, both 
                     <i>ykfJ</i>
                     and <i>prfH</i> may be pseudogenes.  An intact PrfH may 
                     function as a peptide chain release factor.  The 
                     co-occurance of <i>ykfJ</i> and <i>prfH</i> appears to be 
                     evolutionarily conserved and may thus provide insight into 
                     the function of PrfH |CITS: [16970810]|."
     gene            250189..250689
                     /pseudo
                     /gene="prfH"
                     /locus_tag="b0236"
                     /label=prfH
     CDS             250189..250689
                     /pseudo
                     /gene="prfH"
                     /locus_tag="b0236"
                     /product="putative peptide chain release factor"
                     /label=prfH
                     /note="PrfH shows sequence similarity to the peptide chain 
                     release factors RF1 and RF2 |CITS: [1408743]|.
                     Based on the orthologous region in other sequenced 
                     bacterial genomes, a deletion event appears to have removed
                     approximately 1000 bp, encompassing the 3' end of 
                     <i>ykfJ</i> and the 5' end of <i>prfH</i>.  Thus, both 
                     <i>ykfJ</i>
                     and <i>prfH</i> may be pseudogenes.  An intact PrfH may 
                     function as a peptide chain release factor.  The 
                     co-occurance of <i>ykfJ</i> and <i>prfH</i> appears to be 
                     evolutionarily conserved and may thus provide insight into 
                     the function of PrfH |CITS: [16970810]|."
