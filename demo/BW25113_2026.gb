     gene            complement(1789814..1792201)
                     /gene="pheT"
                     /locus_tag="b1713"
                     /label=pheT
     CDS             complement(1789814..1792201)
                     /codon_start=1
                     /gene="pheT"
                     /locus_tag="b1713"
                     /product="multifunctional phenylalanine--tRNA ligase
                     subunit beta / L-tyrosine--tRNA(Phe) ligase / 
                     L-tyrosyl-[tRNA(Phe)] deacylase / phenylalanine--tRNA 
                     ligase"
                     /EC_number="6.1.1.20"
                     /label=pheT
                     /note="The &beta; subunit of PheRS (also called PheST)
                     contains the Phe-tRNA<sup>Phe</sup> binding site |CITS: 
                     [7043240][3893548]|. The editing site of the enzyme 
                     localizes to the B3/B4 domain of the &beta; subunit |CITS: 
                     [15526031]|. Amino acid residues involved in the editing 
                     activity have been identified |CITS: [17185419]|. The B2 
                     OB-fold domain is not essential for catalytic activity, but
                     may play a role as a secondary tRNA binding site in 
                     post-transfer editing |CITS: [16866361]|.
                     Isolated &beta; subunits exist primarily as monomers |CITS:
                     [1915899]|.
                     A Glu571Lys mutant (<i>pheT36</i>) is temperature-sensitive
                     |CITS: [29660847]|.
                     The temperature-sensitive <i>fitA76</i> and <i>fit95</i> 
                     mutants related to <i>pheS</i> and <i>pheT</i>, 
                     respectively, have been genetically characterized |CITS: 
                     [39316172][39419865][40095216][40304830][40464810]|. 
                     Reviews: |CITS: [JAYARAMAN1994]|"
