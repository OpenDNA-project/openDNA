     gene            4179714..4180253
                     /gene="yjaZ"
                     /locus_tag="b3989"
                     /label=yjaZ
     CDS             4179714..4180253
                     /codon_start=1
                     /gene="yjaZ"
                     /locus_tag="b3989"
                     /product="protein YjaZ"
                     /label=yjaZ
                     /note="<i>yjaZ</i> is a gene of unknown function that was 
                     previously thought to code for a heat shock protein, HtrC. 
                     A prior study indicated that ""<i>htrC</i>"" expression was
                     controlled by the heat-shock alternative sigma factor 
                     |FRAME: RPOH-MONOMER| |CITS: [2160943][15757896]|. Putative
                     <i>htrC</i> mutants showed filamentation at intermediate 
                     temperatures, induction of other 
                     &sigma;<sup>32</sup>-modulated heat shock proteins, and 
                     growth defects above 42&deg;C |CITS: [2160943]|. Subsequent
                     reevaluation demonstrated that the original knockout was 
                     not in the <i>htrC/yjaZ</i> coding region.
                     An actual <i>yjaZ</i> mutant has no growth effects at 
                     higher temperatures, nor does it induce expression of heat 
                     shock proteins.  A <i>yjaZ</i> mutant does experience 
                     slowed growth during entrance to stationary phase |CITS: 
                     [16980444]|.
                     <i>yjaZ</i> expression increases 5-fold during entrance to 
                     stationary phase growth |CITS: [16980444]|."
                     /translation="MKQEVEKWRPFGHPDGDIRDLSFLDAHQAVYVQHHEGKEPLEYRF
                     WVTYSLHCFTKDYEHQTNEEKQSLMYHAPKESRPFCQHRYNLARTHLKRTILALPESNV
                     IHAGYGSYAVIEVDLDGGDKAFYFVAFRAFREKKKLRLHVTSAYPISEKQKGKSVKFFT
                     IAYNLLRNKQLPQPSK"
                     /go_component="cytosol [goid 0005829] [evidence IEA] [PMID
                     19054114]"
                     /go_process="response to heat [goid 0009408] [evidence
                     IDA] [PMID 16980444]"
     gene            complement(4180255..4180415)
                     /gene="sroH"
                     /locus_tag="b4691"
                     /label=sroH
     misc_RNA        complement(4180255..4180415)
                     /gene="sroH"
                     /locus_tag="b4691"
                     /product="small RNA SroH"
                     /note="SroH is encoded in the long intergenic region
                     downstream and in the opposite direction of the <i>yiaZ</i>
                     gene.  It has a &sigma;<sup>S</sup>-like promoter and 
                     shares a Rho-independent terminator with <i>yiaZ</i>.  SroH
                     is expressed in stationary phase with a half life of 7 
                     minutes |CITS: [14602901]|.
                     An <i>sroH</i> deletion mutant is sensitive to cell 
                     envelope stress |CITS: [19734312]|.
                     SroH is only conserved in <i>E. coli</i> K-12 and O157 
                     strains |CITS: [14602901]|.
                     Likely functional regions of SroH were identified; of the 
                     predicted mRNA targets, testing by electrophoretic mobility
                     shift assay confirmed an interaction with the <i>kbl</i> 
                     mRNA |CITS: [30287822]|.
                     Review: |CITS: [32213244]|
                     "
     gene            complement(4180663..4181796)
                     /gene="thiH"
                     /locus_tag="b3990"
                     /label=thiH
     CDS             complement(4180663..4181796)
                     /codon_start=1
                     /gene="thiH"
                     /locus_tag="b3990"
                     /product="bifunctional 2-iminoacetate synthase / thiazole
                     synthase"
                     /EC_number="4.1.99.19"
                     /label=thiH
                     /note="2-Iminoacetate synthase (tyrosine lyase, ThiH) 
                     participates in the synthesis of the thiazole moiety of 
                     thiamine |CITS: [8432721]|.  ThiH cleaves the 
                     C&alpha;-C&beta; bond of |FRAME: TYR|, forming |FRAME: 
                     CPD-12279| (dehydroglycine) and generating |FRAME: CPD-108|
                     (<i>p</i>-cresol) as a by-product.
                     2-iminoacetate is one of the three substrates required for 
                     the thiazole cyclization reaction catalyzed by ThiG |CITS: 
                     [17403671][19923213]|.
                     ThiH is a radical SAM enzyme that utilizes a [4Fe-4S] 
                     cluster to reductively cleave |FRAME: S-ADENOSYLMETHIONINE|
                     to yield methionine and a 5'-deoxyadenosyl radical.  The 
                     radical abstracts a phenolic hydrogen atom from |FRAME: 
                     TYR|, which then undergoes C&alpha;-C&beta; bond cleavage 
                     |CITS: [17969213][17403671][19923213]|.
                     ThiG and ThiH purify in a large multimeric complex |CITS: 
                     [12650933]|.  Because |FRAME: CPD-12279| is unstable and 
                     undergoes hydrolysis to glyoxylate and ammonium, complex 
                     formation between ThiG and ThiH may ensure that it is 
                     passed directly to ThiG, where it is incorporated into the 
                     thiazole carboxylate |CITS: [17969213]|.
                     Growth of a <i>thiH</i> mutant requires the presence of 
                     thiazole or thiamine |CITS: [8432721]|.
                     Reviews: |CITS: [10382260][26443755]|"
