                     19054114]"
                     /go_process="negative regulation of cell growth [goid
                     0030308] [evidence IMP] [PMID 14594833]"
     gene            complement(259401..259718)
                     /gene="yafW"
                     /locus_tag="b0246"
                     /label=yafW
     CDS             complement(259401..259718)
                     /codon_start=1
                     /gene="yafW"
                     /locus_tag="b0246"
                     /product="antitoxin of the YkfI-YafW toxin-antitoxin pair"
                     /label=yafW
                     /note="Episomal expression of ykfI causes inhibition of
                     cell growth and decreased viability, compared to wild type 
                     |CITS: [14594833]|, and this phenotype is suppressed by 
                     coexpression of yafW |CITS: [14594833]|. Antitoxin 
                     production reduces toxin abundance, probably by a 
                     post-transcriptional mechanism |CITS: [14594833]|.
                     The YafW and YeeU antitoxins are partially interchangeable 
                     with respect to inhibition of toxicity caused by YkfI or 
                     YeeV production |CITS: [14594833]|. YeeV, YkfI, and YpjF 
                     have similarity to each other and define a protein family 
                     of cellular toxins |CITS: [14594833]|."
