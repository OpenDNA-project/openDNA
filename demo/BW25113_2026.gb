                     EAILYDALRYLSQQIDVWRRQLMLDETQTAEQKLLARYQALSECVKNNRYPGCLFIAAC
                     TFYPDPGHPIHQLADQQKSAAYDFTHELLTTLEVDDPAMVAKQMELVLEGCLSRMLVNR
                     SQADVDTAHRLAEDILRFARCRQGGALT"
