     misc_RNA        4208807..4208891
                     /gene="aceK-int"
                     /locus_tag="b4830"
                     /product="small RNA AceK-int"
                     /note="The Hfq-dependent small RNA AceK-int and 15
                     potential targets, including <i>gatY</i>, <i>gatR</i> and 
                     <i>malT</i>, were identified by 3' end mapping |CITS: 
                     [33460557]| and applying a small RNA prediction algorithm 
                     to RIL-seq data |CITS: [34093460]|.
                     AceK-int is most highly expressed during stationary phase 
                     |CITS: [34093460]| and in minimal media |CITS: [33460557]|.
                     Review: |CITS: [32213244]|"
     gene            complement(4210229..4212415)
                     /gene="arpA"
                     /locus_tag="b4017"
                     /label=arpA
     CDS             complement(4210229..4212415)
                     /codon_start=1
                     /gene="arpA"
                     /locus_tag="b4017"
                     /product="ankyrin-like regulator"
                     /label=arpA
                     /note="ArpA has ankyrin-like repeats |CITS: [8014990]|.
                     A meta-analysis of <i>E. coli</i> K-12 MG1655 
                     transcriptomic data sets in response to multiple stressors 
                     found 15 uncharacterized or partially characterized genes 
                     (<i>yqfA, yhfG, yhhA, ybgS, arpA, yqaE, yfdY, yaiY, yebE, 
                     ydiE, yjcB, yiiX, ycjF, yihF, yidX</i>) that were 
                     upregulated under all five stressors: heat, cold, oxidative
                     stress, nitrosative stress, and antibiotic treatment, 
                     whereas 3 uncharacterized or partially characterized genes 
                     (<i>ymfI, ydiJ, yedE</i>) that were downregulated under all
                     but nitrosative stress |CITS: [36144394]|.
                     Lack of <i>arpA</i> is strongly linked to neonatal 
                     meningitis caused by some pathogenic <i>E. coli</i> strains
                     |CITS: [15071045]|."
