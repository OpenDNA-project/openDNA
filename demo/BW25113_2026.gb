                     /note="The YnbG open reading frame was predicted based on
                     the presence of a ribosome binding site in an intergenic 
                     region, and expression of the small protein was detected 
                     during stationary phase |CITS: [19121005]|."
                     /translation="MKYINCVYNINYKLKPHSHYK"
     gene            join(1459649..1462166,1463503..1463552,1464776..1468270)
                     /pseudo
                     /gene="ydbA"
                     /locus_tag="b4492"
                     /label=ydbA
                     /note="Comment from EcoGene: Two independent insertions,
                     IS30C and IS2D, interrupt <i>ydbA</i>. The IS2D insertion 
                     is in codon 839 and made a 5 bp target site duplication 
                     AACCC. The IS30C insertion is in codon 856 and made a 2 bp 
                     target site duplication CT. The pre-insertion YdbA sequence
                     has been reconstructed and is consistent with the sequence 
                     of a closely-related <i>E. coli</i> 53638 protein with this
                     region intact (NCBI gi 75515008). The first 21 aa of YdbA 
                     are predicted to be a type I signal peptide. The 17 codons 
                     between the two insertions encode PELTYADSGAKIVNKGT and 
                     were overlooked in previous reconstructions."
     CDS             join(1459649..1462166,1463503..1463552,1464776..1468270)
                     /pseudo
                     /gene="ydbA"
                     /locus_tag="b4492"
                     /product="putative outer membrane protein, N-terminal
                     fragment"
                     /label=ydbA
                     /note="Sequence similarity suggests that YdbA is a member
                     of the Autotransporter (AT) family of proteins |CITS: 
                     [12192075]|.
                     A &Delta;<i>ydbA</i> mutant has aggravating genetic 
                     interactions with genes involved in mismatch repair |CITS: 
                     [26774489]|.
                     "
