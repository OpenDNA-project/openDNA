                     |CITS: [33917325]|."
                     /translation="MTYDSEFGSHVSLYRDRIKQVIDDSLNEHLNSMILRVDLHDPIDT
                     ENMDNPFFQPRVDSGAISRFTSALKAKLKHDKHIKTQRKDWPDSRHSTLRYAWVREYTK
                     NRKRHYHLILCFNQDAYYHLGDYDLNRNTLRTMITTAWYSALGIPIDSSGKLVNYPPNG
