     gene            298702..299316
                     /gene="yagU"
                     /locus_tag="b0287"
                     /label=yagU
     CDS             298702..299316
                     /codon_start=1
                     /gene="yagU"
                     /locus_tag="b0287"
                     /product="DUF1440 domain-containing inner membrane protein
                     YagU"
                     /label=yagU
                     /note="Membrane topology predictions using experimentally 
                     determined C terminus locations indicate that YagU has 4 
                     transmembrane helices and the C-terminus is located in the 
                     cytoplasm |CITS: [15044727]|.  YagU has been found as a 
                     dimer in the inner membrane |CITS: [16079137]|.
                     Expression of <i>yagU</i> is induced by acid |CITS: 
                     [17026754][18302792]| and repressed after induction of 
                     expression of the toxic peptide IbsC |CITS: [18710431]|.
                     A <i>yagU</i> mutant shows lower resistance to acid than 
                     wild type |CITS: [17026754]|."
                     /translation="MNIFEQTPPNRRRYGLAAFIGLIAGVVSAFVKWGAEVPLPPRSPV
