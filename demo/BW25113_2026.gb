     gene            1274793..1274976
                     /gene="narS"
                     /locus_tag="b4813"
                     /label=narS
     misc_RNA        1274793..1274976
                     /gene="narS"
                     /locus_tag="b4813"
                     /product="putative small regulatory RNA NarS"
                     /note="The Hfq-dependent small RNA NarS and 8 potential
                     targets were identified by applying a small RNA prediction 
                     algorithm to RIL-seq data |CITS: [34093460]|.  The 
                     homologous small RNA from <i>Salmonella</i> Typhimurium 
                     SL1344 is processed from the 3' end of the <i>narK</i> mRNA
                     by RNase E and was shown to inhibit expression of the 
                     nitrite transporter NirC.  The nucleotide sequence of the 
                     NarS-<i>nirC</i> base pairing region is conserved between 
                     <i>Salmonella</i> and <i>E. coli</i> |CITS: [31863581]|. 
                     NarS is most highly expressed during exponential growth and
                     under iron limitation |CITS: [34093460]|.
                     "
     gene            1275320..1279063
                     /gene="narG"
                     /locus_tag="b1224"
                     /label=narG
     CDS             1275320..1279063
                     /codon_start=1
                     /gene="narG"
                     /locus_tag="b1224"
                     /product="multifunctional nitrate reductase A subunit
                     alpha / nitrate reductase A / menaquinol:nitrate 
                     oxidoreductase / ubiquinol:nitrate oxidoreductase / 
                     tellurite reductase"
                     /EC_number="1.7.5.1"
                     /label=narG
                     /note="The &alpha; subunit of nitrate reductase A is the
                     site of nitrate reduction; it contains the molybdenum 
                     cofactor |FRAME: CPD-15873| (<i>bis</i>-MGD and an FS0 
                     |FRAME: CPD-7 [4Fe-4S]| cluster |CITS: 
                     [12910261][14725769][15122898][20053990]|. The assembly of 
                     FS0 in nitrate reductase A is a prerequisite for 
                     <i>bis</i>-MGD insertion |CITS: [20053990]|.
                     The enzyme-specific chaperone |FRAME: NARJ-MONOMER 
                     ""NarJ""| facilitates <i>bis</i>-MGD insertion within the 
                     apoenzyme complex; NarJ interacts specifically with NarG 
                     |CITS: [9632249][16286471][16540088][19295650][20236317][3 
                     8262549]|. NarG contains a vestigal twin-arginine leader 
                     sequence |CITS: [15213747]|.
                     NarG and NarH are significantly upregulated in a 
                     &Delta;|FRAME: CPLX0-245 Ahp| strain compared to wild type 
                     and redox proteomics indicates that cysteine sites in 
                     peptides (NarG<sub>Cys-292</sub>/NarH<sub>Cys-217</sub>) 
                     are significantly reduced |CITS: [37725887]|.
                     <i>nar</i>: <U>n</U>itr<U>a</U>te <U>r</U>eductase; 
                     <i>chl</i>: <U>ch</U>lorate resistant |CITS: [7047497]|"
