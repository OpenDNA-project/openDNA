     gene            complement(1309527..1310027)
                     /gene="yciF"
                     /locus_tag="b1258"
                     /label=yciF
     CDS             complement(1309527..1310027)
                     /codon_start=1
                     /gene="yciF"
                     /locus_tag="b1258"
                     /product="DUF892 domain-containing protein YciF"
                     /label=yciF
                     /note="YciF is highly conserved across 
                     <i>Enterobacteriaceae</i>.  Its expression is induced under
                     osmotic stress imposed by NaCl in both aerobic and 
                     anaerobic conditions |CITS: [15716429][17015655]| and 
                     repressed by H-NS |CITS: [8455549]|.  YciF is part of the 
                     &sigma;<sup>S</sup> regulon |CITS: [15716429]|.  The 
                     <i>yciGFE</i> locus is expressed poorly |CITS: [20713450]|.
                     The <i>yciF</i> gene of <i>Salmonella enterica</i> serovar 
                     Typhimurium is regulated by RpoS (&sigma;<sup>S</sup>) 
                     |CITS: [11004173]| and by bile independent of RpoS |CITS: 
                     [15145463]|.
                     A crystal structure of YciF has been solved at 2 &Aring; 
                     resolution; it was found to be a structural homolog of 
                     rubrerythrin, a protein with a diiron center.  YciF forms a
                     dimer both in the crystal structure and in solution |CITS: 
                     [17001035]|."
                     /translation="MNMKTIEDVFIHLLSDTYSAEKQLTRALAKLARATSNEKLSQAFH
                     AHLEETHGQIERIDQVVESESNLKIKRMKCVAMEGLIEEANEVIESTEKNEVRDAALIA
                     AAQKVEHYEIASYGTLATLAEQLGYRKAAKLLKETLEEEKATDIKLTDLAINNVNKKAE
                     NKA"
                     /go_component="cytosol [goid 0005829] [evidence IEA] [PMID
                     26602691]"
                     /go_function="protein homodimerization activity [goid
