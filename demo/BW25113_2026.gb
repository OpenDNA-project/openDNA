     gene            complement(724188..724277)
                     /gene="kdpF"
                     /locus_tag="b4513"
                     /label=kdpF
     CDS             complement(724188..724277)
                     /codon_start=1
                     /gene="kdpF"
                     /locus_tag="b4513"
                     /product="trifunctional K(+) transporting P-type ATPase
                     subunit KdpF / K(+) transporting P-type ATPase / K(+) 
                     transporting ATPase"
                     /EC_number="7.2.2.6"
                     /label=kdpF
                     /note="KdpF is a small membrane protein that is part of a 
                     potassium ion transporting P-type ATPase complex.
                     KdpF may function to stabilise the transporter complex; 
                     inactivation of <i>kdpF</i> does not affect growth under 
                     low potassium conditions (0.1 mM K<sup>+</sup>) however the
                     purified complex lacking KdpF exhibits significantly 
                     decreased K<sup>+</sup>-stimulated ATPase activity; 
                     addition of purified KdpF restores K<sup>+</sup>-stimulated
                     ATPase activity to near wild type levels, as does the 
                     addition of <i>E. coli</i> lipids |CITS: 
                     [9789555][10608856]|.
                     KdpF is predicted to be a bitopic inner membrane protein 
                     |CITS: [27510400]|.
                     "
