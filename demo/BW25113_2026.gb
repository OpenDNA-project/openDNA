     gene            1998784..1999194
                     /gene="fliS"
                     /locus_tag="b1925"
                     /label=fliS
     CDS             1998784..1999194
                     /codon_start=1
                     /gene="fliS"
                     /locus_tag="b1925"
                     /product="flagellar biosynthesis protein FliS"
                     /label=fliS
                     /note="FliS, along with FliT and FlgN, are cytoplasmic, 
                     substrate-specific chaperones of the flagellar export 
                     system. They share several similarities with other type III
                     cytoplasmic chaperone family members |CITS:[8028576]|. 
                     Mutation-deletion studies have shown that FliS is the 
                     chaperone for FliC or flagellin, the subunit which 
                     polymerizes to form the filament of the flagellar structure
                     |CITS:[7551038]|. FliS has also been shown to be 
                     responsible for negatively regulating the export of FlgM, 
                     the anti-sigma factor |CITS:[8550529]|. Co-purification and
                     affinity blotting studies showed that FliS binds to the 
                     C-terminal 40 amino acid region of the D0 domain of FliC 
                     which is the polymerization domain and without FliS binding
                     the
                     C-terminus is degraded. This supports the role of FliS as a
                     domain-specific chaperone that prevents degradation of FliC
                     as well as premature self-aggregation |CITS:[8028576]|."
                     /translation="MYAAKGTQAYAQIGVESAVMSASQQQLVTMLFDGVLSALVRASLF
                     MQDNNQQGKGVSLSKAINIIENGLRVSLDEESKDELTQNLIALYSYMVRRLLQANLRND
                     VSAVEEVEALMRNIADAWKESLLSPSLIQDPV"
