     gene            4230253..4230663
                     /gene="psiE"
                     /locus_tag="b4030"
                     /label=psiE
     CDS             4230253..4230663
                     /codon_start=1
                     /gene="psiE"
                     /locus_tag="b4030"
                     /product="putative phosphate starvation-inducible protein
                     PsiE"
                     /label=psiE
                     /note="A large-scale phenotypic study of a <i>psiE</i>
                     mutant is presented |CITS: [12897016]|.
                     Regulation has been described |CITS: 
                     [6304324][3540312][10986267]|.  Transcription of the 
                     <i>psiE</i> gene is activated upon starvation for 
                     phosphate, carbon, or nitrogen |CITS: [6304324]|; 
                     regulation shows some response to PhoB and PhoR, but not 
                     PhoM |CITS: [6304324]|, and also involves PhoT |CITS: 
                     [6304324]| and cAMP-CRP  |CITS: [6304324][10986267]|. 
                     Membrane topology predictions using experimentally 
                     determined C terminus locations indicate that PsiE has 
                     three transmembrane helices and the C-terminus is located 
                     in the cytoplasm |CITS: [15044727]|.
                     PsiE: ""<b>p</b>hosphate 
                     <b>s</b>tarvation-<b>i</b>nducible"" |CITS: [6304324]|
                     "
                     /translation="MTSLSRPRVEFISTILQTVLNLGLLCLGLILVVFLGKETVHLADV
                     LFAPEQTSKYELVEGLVVYFLYFEFIALIVKYFQSGFHFPLRYFVYIGITAIVRLIIVD
