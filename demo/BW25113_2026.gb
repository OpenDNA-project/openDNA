     gene            complement(4515923..4516705)
                     /gene="sgcR"
                     /locus_tag="b4300"
                     /label=sgcR
     CDS             complement(4515923..4516705)
                     /codon_start=1
                     /gene="sgcR"
                     /locus_tag="b4300"
                     /product="KpLE2 phage-like element; putative DNA-binding 
                     transcriptional regulator SgcR"
                     /label=sgcR
                     /note="SgcR, which contains a helix-turn-helix motif to
                     bind DNA in its N-terminal domain, was predicted to 
                     regulate genes related to metabolism |CITS: [35880217]|. 
                     Upstream of the <i>sgcR</i> gene, a sequence was found that
                     could work as a transcriptional promoter, and the 
                     transcription of the <i>sgcR</i> gene is affected by 
                     glucose-lactose shift and glucose-acetate shift |CITS: 
                     [35880217]|.
                     The SgcR binding landscape was globally mapped in vivo by 
                     standardized ChIP-seq and quantitatively modeled using 
                     BoltzNet, a biophysically informed neural network that 
                     infers binding energy from sequence data |CITS:[40335485]|.
                     The resulting ChIP-seq binding regions are available in 
                     RegulonDB (<a href=""https://regulondb.cc 
                     g.unam.mx/ht/dataset/TFBINDING/source=GALAGAN"">Galagan 
                     collection</a>), and the corresponding energy matrix and 
                     genomic binding profiles can be accessed at <a 
                     href=""http://boltznet.bu.edu"">boltznet.bu.edu</a> 
                     |CITS:[40335485]|."
                     /translation="MSQQRPDRIKQMLHYLWQHRHLSTQQAMELFGYAEATVRRDFQYI
