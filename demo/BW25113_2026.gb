     gene            complement(4274827..4275141)
                     /gene="yjcH"
                     /locus_tag="b4068"
                     /label=yjcH
     CDS             complement(4274827..4275141)
                     /codon_start=1
                     /gene="yjcH"
                     /locus_tag="b4068"
                     /product="DUF485 domain-containing inner membrane protein
                     YjcH"
                     /label=yjcH
                     /note="<i>yjcH</i> is cotranscribed with the <i>acs</i>
                     and <i>actP</i> genes, which encode proteins involved in 
                     acetate dissimilation and transport |CITS: [14563880]|. 
                     High-throughput identification of mutant phenotypes under 
                     multiple experimental conditions showed a similar fitness 
                     pattern of <i>yjcH</i> and <i>actP</i> mutants ; the 
                     authors suggests that YjcH may be required for activity of 
                     the ActP transporter |CITS: [29769716]|."
                     /translation="MNGTIYQRIEDNAHFRELVEKRQRFATILSIIMLAVYIGFILLIA
                     FAPGWLGTPLNPNTSVTRGIPIGVGVIVISFVLTGIYIWRANGEFDRLNNEVLHEVQAS
                     "
