     CDS             complement(664752..665363)
                     /codon_start=1
                     /gene="cobC"
                     /locus_tag="b0638"
                     /product="trifunctional putative adenosylcobalamin 
                     phosphatase/alpha-ribazole phosphatase / adenosylcobalamin 
                     5'-phosphate phosphatase / alpha-ribazole-5'-P phosphatase"
                     /EC_number="3.1.3.73"
                     /label=cobC
                     /note="The CobC protein has not been characterised in
                     <i>E. coli</i> K-12 but is predicted to be an 
                     adenosylcobalamin 5'-phosphate phosphatase by homology with
                     <i>cobC</i> from <i>Salmonella typhimurium</i>. Early 
                     studies in <i>S. typhimurium</i> suggested that CobC was an
                     &alpha;-ribazole phosphatase |CITS: [7929373]| but more 
                     recently it was shown that adenosylcobalamin 5'-phosphate 
                     was the preferred substrate and that CobC catalyses the 
                     last step of adenosylcobalamin (coenzyme B12) biosynthesis 
                     |CITS: [17209023]|."
