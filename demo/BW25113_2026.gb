     gene            complement(2576262..2576837)
                     /gene="nudK"
                     /locus_tag="b2467"
                     /label=nudK
     CDS             complement(2576262..2576837)
                     /codon_start=1
                     /gene="nudK"
                     /locus_tag="b2467"
                     /product="GDP-mannose hydrolase"
                     /label=nudK
                     /note="The <i>nudK</i> gene product is a member of the 
                     ADP-ribose pyrophosphatase subfamily of the Nudix 
                     hydrolases.  The enzyme has GDP-mannose hydrolase activity 
                     and prefers purine over pyrimidine nucleotide sugars as 
                     substrates |CITS: [16766526]|.
                     NudK was described to be either a homotrimer |CITS: 
                     [16766526]| or a homodimer |CITS: [21638333]| in solution. 
                     A crystal structure has been solved at 2.4 &Aring; 
                     resolution |CITS: [16021622]|.  Additional crystal 
                     structures show the enzyme in a domain-swapped dimer 
                     conformation |CITS: [21638333]|.  Residues important for 
                     metal binding and catalytic activity were confirmed by 
                     site-directed mutagenesis |CITS: [21638333]|.
                     Deletion of <i>nudK</i> does not affect biofilm formation 
                     |CITS: [21638333]|.  Overexpression of <i>nudK</i> 
                     suppresses the essentiality of |FRAME: EG12691-MONOMER 
                     ""<i>lapB</i>""|, which encodes a protein involved in 
                     lipopolysaccharide (LPS) assembly |CITS: [24722986]|. 
                     Review: |CITS: [16378245]|
                     "
