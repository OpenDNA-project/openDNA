     gene            4447776..4449128
                     /gene="tldE"
                     /locus_tag="b4235"
                     /label=tldE
     CDS             4447776..4449128
                     /codon_start=1
                     /gene="tldE"
                     /locus_tag="b4235"
                     /product="trifunctional metalloprotease subunit TldE / 
                     metalloprotease TldDE / microcin B17 precursor protease"
                     /label=tldE
                     /note="TldD and TldE form a stable heterodimeric complex
                     with protease activity |CITS: [28943336]|.
                     <i>tldE</i> mutants harboring the pMccB17 plasmid show 
                     impaired production of Microcin B17 |CITS: [2082149]|; a 
                     deletion mutant accumulates the unprocessed Microcin B17 
                     precursor protein, in contrast to wild type, which 
                     processes and exports Microcin B17 from the cell |CITS: 
                     [12029038]|.  A <i>tldE</i> mutant exhibits resistance to 
                     the F plasmid-encoded LetD DNA gyrase inhibitor |CITS: 
                     [8604133]|, but only in the presence of the LetD inhibitor 
                     LetA |CITS: [12029038]|.  A <i>csrA</i> mutation suppresses
                     the Tld phenotype of a <i>tldE</i> mutant |CITS: 
                     [8604133]|.
                     PmbA: ""<b>p</b>roduction of <b>M</b>icrocin <b>B</b>17, 
                     locus <b>A</b>"" |CITS: [2082149]|
                     TldE: ""<b>t</b>olerant for <i><b>l</b>et<b>D</b></i> 
                     expression <b>E</b>"" |CITS: [8604133]|
                     Reviews: |CITS: [ 36155963]|"
