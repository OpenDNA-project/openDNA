     gene            complement(1935908..1936840)
                     /gene="znuA"
                     /locus_tag="b1857"
                     /label=znuA
     CDS             complement(1935908..1936840)
                     /codon_start=1
                     /gene="znuA"
                     /locus_tag="b1857"
                     /product="bifunctional Zn(2+) ABC transporter periplasmic
                     binding protein / Zn(2+) ABC transporter"
                     /EC_number="7.2.2.20"
                     /label=znuA
                     /note="ZnuA is the periplasmic binding protein of an 
                     ATP-dependent Zn<sup>2+</sup> uptake system.
                     High resolution crystal structures of ZnuA with bound 
                     Zn<sup>2+</sup> consist of two structually similar domains 
                     (the N and C domains) connected by a long &alpha;-helix; a 
                     single Zn<sup>2+</sup> binds at the interface between the 
                     two domains |CITS: [17306297][17399739]|. Purified ZnuA 
                     interacts with Co<sup>2+</sup>, Ni<sup>2+</sup>, Cd 
                     <sup>2+</sup>, Cu<sup>2+</sup> and Cu<sup>+</sup>; purified
                     ZnuA binds Zn<sup>2+</sup> with high affinity 
                     (K<sub>d</sub> < 20 nM) |CITS: [18027003]|. ZnuA contains a
                     second zinc-binding site, likely to have lower affinity for
                     zinc than the primary site |CITS: [18027003]|. <i>znuA</i> 
                     belongs to a network of genes which facilitate 
                     stress-induced mutagenesis (SIM) in <i>E. coli</i> K-12 
                     |CITS: [23224554]|.
                     <i>znu</i>: <U>Zn</U><sup>2+</sup> <U>u</U>ptake |CITS: 
                     [9680209]|"
