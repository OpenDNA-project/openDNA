     gene            complement(4311514..4312239)
                     /gene="phnF"
                     /locus_tag="b4102"
                     /label=phnF
     CDS             complement(4311514..4312239)
                     /codon_start=1
                     /gene="phnF"
                     /locus_tag="b4102"
                     /product="putative transcriptional regulator PhnF"
                     /label=phnF
                     /note="PhnF is a predicted transcriptional regulator that 
                     belongs to the HutC subfamily of the GntR family of 
                     transcriptional regulators.  It consists of two domains, an
                     amino-terminal domain that contains a potential 
                     helix-turn-helix DNA-binding motif and a carboxy-terminal 
                     domain involved in effector recognition |CITS: 
                     [11756427][12757941][16672238]|.
                     A crystal structure of the C-terminal domain of PhnF has 
                     been solved at 1.7 &Aring; resolution |CITS: [16672238]|. A
                     non-polar <i>phnF</i> mutation has no effect on the ability
                     to utilize phosphonates as the source of phosphate |CITS: 
                     [8388873]|.  A <i>phnF</i> mutant accumulates presumed 
                     intermediates of the C-P lyase pathway of phosphonate 
                     degradation |CITS: [19854894]|.
                     "
