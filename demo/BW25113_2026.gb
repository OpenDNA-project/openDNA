     gene            complement(2873733..2874407)
                     /gene="casD"
                     /locus_tag="b2757"
                     /label=casD
     CDS             complement(2873733..2874407)
                     /codon_start=1
                     /gene="casD"
                     /locus_tag="b2757"
                     /product="trifunctional type I-E CRISPR system Cascade
                     subunit CasD / CRISPR-associated complex for antiviral 
                     defense / CRISPR RNA processing"
                     /label=casD
                     /note="CasD interacts with one CasC subunit (Cas7.6) and
                     with CasA to form the tail of the Cascade complex. CasD 
                     also contributes to crRNA binding |CITS: [25103409]|. 
                     Residues in the L1-helix and the &beta;-hairpin of CasD are
                     required for dsDNA binding of Cascade |CITS: [26243775]|.
                     CasA is required for the double-stranded target DNA binding
                     activity of Cascade |CITS: [22521690]|. Deletions of each 
                     Cas subunit (CasA, B, C, D, E) were made; CasA, CasC and 
                     CasD were found to be indispensible whereas CasB was 
                     dispensible for gene silencing and plasmid interference 
                     |CITS: [40401996]|.
                     CasD: ""<b>C</b>RISPR-<b>as</b>sociated"" |CITS: 
                     [18703739]|"
