     gene            complement(308852..308953)
                     /gene="ykgR"
                     /locus_tag="b4671"
                     /label=ykgR
     CDS             complement(308852..308953)
                     /codon_start=1
                     /gene="ykgR"
                     /locus_tag="b4671"
                     /product="uncharacterized membrane protein YkgR"
                     /label=ykgR
                     /note="The <i>ykgR</i> open reading frame was predicted
                     based on the presence of a ribosome binding site in an 
                     intergenic region.  YkgR contains a predicted transmembrane
                     segment.  YkgR is expressed more highly during exponential 
                     growth than during stationary phase |CITS: [19121005]|. The
                     majority of YkgR partitions into the inner membrane 
                     fraction using a sucrose fractionation protocol |CITS: 
                     [21778229]|. Topology assays using GFP and PhoA fusion 
                     proteins suggest that YkgR is oriented with the C-terminus 
                     in the periplasm |CITS: [21778229]|. Translocation of YkgR 
                     is impaired in a SecE depleted <i>E. coli</i> strain |CITS:
                     [21778229]|."
