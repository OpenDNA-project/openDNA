     gene            complement(4300924..4301859)
                     /gene="alsB"
                     /locus_tag="b4088"
                     /label=alsB
     CDS             complement(4300924..4301859)
                     /codon_start=1
                     /gene="alsB"
                     /locus_tag="b4088"
                     /product="bifunctional D-allose ABC transporter
                     periplasmic binding protein / D-allose ABC transporter"
                     /EC_number="7.5.2.8"
                     /label=alsB
                     /note="AlsB is the periplasmic binding protein of a
                     D-allose ATP-binding cassette (ABC) transport system.
                     AlsB binds D-allose with high affinity (K<sub>D</sub> = 
                     0.33 &micro;M) |CITS: [9401019]|. A crystal structure of 
                     AlsB bound to D-allose has been reported |CITS: 
                     [10064713]|; the protein contains two &alpha;/&beta; 
                     domains joined by a 3 stranded hinge and adopts a closed 
                     conformation in which a &beta; D-allopyranose form of the 
                     sugar is buried at the interface between the two domains. 
                     Ligand free structures of AlsB adopt a conformation in 
                     which the interface between the two domains is opened up to
                     the solvent; conformational change between ligand free 
                     (open) and liganded (closed) forms is associated with 
                     movement of the hinge |CITS: [11825912]|.
                     Overexpression of <i>alsB</i> increases the tolerance of 
                     <i>E. coli</i> to n-butanol |CITS: [21408113]|."
