     CDS             3890866..3891333
                     /codon_start=1
                     /gene="cbrB"
                     /locus_tag="b3716"
                     /product="putative inner membrane protein"
                     /label=cbrB
                     /note="Transcription of <i>cbrB</i>, the first gene of the 
                     predicted <i>cbrBC</i> transcription unit, is induced by 
                     the CreBC
                     two-component system by minimal media growth conditions 
                     |CITS: [11350954]|.
                     Certain <i>cbrBC</i> mutants show hypersensitivity to 
                     nitrofurzone |CITS: [12897016]|.
                     CbrB is an inner membrane protein with four predicted 
                     transmembrane domains.  The C terminus is located in the 
                     cytoplasm |CITS: [15919996]|.
                     CbrB: ""<i>creB</i>-regulated"" |CITS: [12897016]|"
                     /translation="MSVSRRVIHHGLYFAVLGPLIGVLFLVLYIFFAKEPLVLWVIIHP
