                     /locus_tag="b2181"
                     /label=yejG
     CDS             complement(2271372..2271716)
                     /codon_start=1
                     /gene="yejG"
                     /locus_tag="b2181"
                     /product="protein YejG"
                     /label=yejG
                     /note="Overexpression of YejG leads to slightly increased 
                     resistance to the aminoglycoside antibiotics apramycin, 
                     sisomicin and tobramycin |CITS: [21173244]|.
                     A solution structure of YejG shows that the protein has a 
                     stucture similar to the RNA recognition motif domain III of
                     |FRAME: EG10360-MONOMER|.  However, YejG does not appear to
                     co-purify with the ribosome or bind to nucleic acids |CITS:
                     [30958578]|.
                     Expression of <i>yejG</i> is slightly upregulated in 
                     response to treatment with citral, and a &Delta;<i>yejG</i>
                     mutant is inhibited more strongly by citral |CITS: 
                     [28644990]|."
                     /translation="MTSLQLSIVHRLPQNYRWSAGFAGSKVEPIPQNGPCGDNSLVALK
                     LLSPDGDNAWSVMYKLSQALSDIEVPCSVLECEGEPCLFVNRQDEFAATCRLKNFGVAI
