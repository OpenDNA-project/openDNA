     gene            complement(1816175..1816513)
                     /gene="osmE"
                     /locus_tag="b1739"
                     /label=osmE
     CDS             complement(1816175..1816513)
                     /codon_start=1
                     /gene="osmE"
                     /locus_tag="b1739"
                     /product="osmotically-inducible lipoprotein OsmE"
                     /label=osmE
                     /note="OsmE has a lipoprotein-type signal sequence at the
                     amino terminus |CITS: [7565114]| and is a verified 
                     lipoprotein according to unpublished data by S. Matsuyama 
                     et al. (cited in |CITS: [12876315]|).
                     OsmE is an osmotically inducible gene product in <i>E. 
                     coli</i>.  Operon fusion experiments demonstrated that 
                     <i>osmE</i> osmotic regulation probably occurs at the 
                     transcriptional level |CITS: [7565114]|.  Under conditions 
                     of low osmolarity, <i>osmE</i> is induced at the onset of 
                     stationary phase |CITS: [9367747]|.  In the absence of 
                     &sigma;<sup>S</sup>, the stationary phase sigma factor 
                     encoded by <i>rpoS</i>, stationary phase induction does not
                     occur, but the osmotic effect is still observed |CITS: 
                     [9367747]|.
                     An <i>osmE</i> nonsynonymous mutation (OsmE<sub>S44N</sub>)
                     contributes to colistin resistance in a laboratory evolved 
                     strain |CITS: [35680894]|.
                     "
                     /translation="MNKNMAGILSAAAVLTMLAGCTAYDRTKDQFVQPVVKDVKKGMSR
                     AQVAQIAGKPSSEVSMIHARGTCQTYILGQRDGKAETYFVALDDTGHVINSGYQTCAEY
                     DTDPQAAK"
