     gene            complement(3584369..3585685)
                     /gene="ugpB"
                     /locus_tag="b3453"
                     /label=ugpB
     CDS             complement(3584369..3585685)
                     /codon_start=1
                     /gene="ugpB"
                     /locus_tag="b3453"
                     /product="multifunctional sn-glycerol 3-phosphate ABC
                     transporter periplasmic binding protein / sn-glycerol 
                     3-phosphate / glycerophosphodiester ABC transporter / 
                     transport of glycerol-3-phosphate / transport of a 
                     glycerophosphodiester"
                     /EC_number="7.6.2.10"
                     /label=ugpB
                     /note="UgpB is the periplasmic binding component of the 
                     <i>sn</i>-glycerol 3-phosphate (G3P) ABC transporter in 
                     <i>E. coli</i> K-12 |CITS: [387762]|. Purified UgpB binds 
                     G3P and |FRAME: L-1-GLYCERO-PHOSPHORYLCHOLINE 
                     ""glycerophosphocholine""| with dissociation constants of 
                     0.68 &micro;M and 5.1 &micro;M respectively |CITS: 
                     [23013274]|. UgpB binds glycerophosphoethanolamine |CITS: 
                     [2842304]|. UgpB has the characteristic structure of 
                     periplasmic binding proteins - two globular domains 
                     connected by a hinge; G3P binds at the interface of the two
                     domains |CITS: [23013274]|.
                     UgpB also functions as a molecular chaperone to prevent 
                     bile-induced protein aggregation; purified UgpB prevents 
                     cholate-induced aggregation of the model chaperone 
                     substrates malate dehydrogenase (MDH), lactate 
                     dehydrogenase (LDH), and citrate synthase (CS) in a 
                     dose-dependent manner; G3P binding and chaperone activity 
                     are likely mutually exclusive and may be modulated in 
                     response to variations in pH and G3P concentration in the 
                     digestive tract |CITS: [32882062]|."
                     /translation="MKPLHYTASALALGLALMGNAQAVTTIPFWHSMEGELGKEVDSLA
                     QRFNAENPDYKIVPTYKGNYEQNLSAGIAAFRTGNAPAILQVYEVGTATMMASKAIKPV
