     gene            4013338..4013589
                     /gene="esrE"
                     /locus_tag="b4707"
                     /label=esrE
     misc_RNA        4013338..4013589
                     /gene="esrE"
                     /locus_tag="b4707"
                     /product="small RNA EsrE"
                     /note="The small RNA EsrE appeared to be essential for
                     growth when first identified |CITS: [22575655]|. However, a
                     later publication showed that the |FRAME: EG11474 
                     <i>ubiJ</i>| gene, which includes <i>esrE</i>, can be 
                     deleted |CITS: [24142253]|.
                     Potential regulatory targets of EsrE have been identified 
                     |CITS: [28900423][31553492]|.
                     <i>esrE</i> appears to be expressed during late exponential
                     growth |CITS: [28900423]|. Expression of <i>esrE</i> is 
                     upregulated by Fur in the presence of Fe<sup>2+</sup> 
                     |CITS: [31693839]|. In a <i>esrE</i> mutant that 
                     overexpresses EsrE but doesn't affect UbiJ function, the 
                     abundance of a number of proteins is changed. This includes
                     downregulation of AstC and upregulation of PurL |CITS: 
                     [31553492]|.
                     EsrE: ""<b>e</b>ssential <b>s</b><b>R</b>NA in <i><b>E</b>.
                     coli</i>"" |CITS: [22575655]|"
     gene            4013586..4015226
                     /gene="ubiB"
                     /locus_tag="b3835"
                     /label=ubiB
     CDS             4013586..4015226
                     /codon_start=1
                     /gene="ubiB"
                     /locus_tag="b3835"
                     /product="ubiquinone biosynthesis protein UbiB"
                     /label=ubiB
                     /note="UbiB is involved in the biosynthesis of
                     ubiquinone-8.  Until recently, it was thought to provide 
                     the 2-octaprenylphenol hydroxylase activity, which 
                     catalyzes the first hydroxylation step in the ubiquinone 
                     biosynthesis pathway.  However, no direct biochemical 
                     evidence for the enzymatic function of UbiB is available, 
                     and the reaction is now thought to be catalyzed by |FRAME: 
                     EG11333-MONOMER ""UbiI""| |CITS: [23709220]|.  UbiB is part
                     of an atypical protein kinase-like family and thus may 
                     function as a regulator |CITS: [9799791][10960098]|.
                     A <i>ubiB</i> insertion mutant does not grow on succinate 
                     as the sole source of carbon and has a slow growth 
                     phenotype |CITS: [9422602]|.  <i>ubiB</i> mutants 
                     accumulate 2-octaprenylphenol |CITS: 
                     [4897112][4572721][365223][10960098]|.  The original 
                     <i>ubiB</i> allele of strain AN59 contains an IS<i>1</i> 
                     insertion in <i>ubiE</i>, located upstream of <i>ubiB</i>, 
                     which appears to have a polar effect on <i>ubiB</i> |CITS: 
                     [10960098]|.
                     The human <a 
                     href=""https://www.omim.org/entry/606980"">COQ8A</a> 
                     protein is a member of the UbiB protein family and is 
                     associated with ubiquinone-10 biosynthesis.  Mutations in 
                     COQ8A are associated with the autosomal recessive disease 
                     <a href=""https://www.omim.org/entry/612016"">primary 
                     coenzyme Q10 deficiency 4</a>.
                     Reviews: |CITS: [11583838][11153266]|"
