     gene            1708634..1709239
                     /gene="gstA"
                     /locus_tag="b1635"
                     /label=gstA
     CDS             1708634..1709239
                     /codon_start=1
                     /gene="gstA"
                     /locus_tag="b1635"
                     /product="bifunctional glutathione S-transferase GstA /
                     glutathione S-transferase"
                     /EC_number="2.5.1.18"
                     /label=gstA
                     /note="Glutathione S-transferase (Gst) acts as a
                     detoxifying enzyme that is thought to protect the cell from
                     foreign compounds.  The enzyme is active toward 
                     1-chloro-2,4-dinitrobenzene |CITS: [2185038][7798255]|.
                     In addition, it also has a low level of 
                     glutathione-dependent peroxidase activity toward cumene 
                     hydroperoxide |CITS: [2185038][7798255]| as well as 
                     thiol:disulfide oxidoreductase activity using 
                     bis-(2-hydroxyethyl) disulfide |CITS: [18778244]|.
                     Crystal structures of Gst have been determined at 2.1 and 
                     1.9 &Aring; resolution |CITS: [9680481][14635120]|.  Based 
                     on the structural information, Cys10 and His106 are thought
                     to be involved in catalysis |CITS: [9680481]|. 
                     Site-directed mutagenesis of these residues suggest that 
                     His106 plays a role in catalysis and Cys10 is involved in 
                     binding the glutathione substrate |CITS: [18778244]|. 
                     Site-directed mutagenesis of the apparently conserved Tyr5 
                     residue showed that it is not required for catalytic 
                     activity |CITS: [7798255]|.
                     Deletion of <i>gstA</i> leads to increased sensitivity to 
                     hydrogen peroxide |CITS: [17018556]|.  A strain lacking 
                     AcrB, a multidrug efflux pump, becomes less sensitive 
                     towards the fungicide chlorothalonil upon overexpression of
                     Gst |CITS: [15357291]|.
                     Review: |CITS: [19016852]|"
