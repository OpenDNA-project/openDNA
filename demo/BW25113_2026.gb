     gene            1212204..1212452
                     /gene="ymgC"
                     /locus_tag="b1167"
                     /label=ymgC
     CDS             1212204..1212452
                     /codon_start=1
                     /gene="ymgC"
                     /locus_tag="b1167"
                     /product="protein YmgC"
                     /label=ymgC
                     /note="Deletion of <i>ymgC</i> increases biofilm formation
                     and motility |CITS: [17765265]|.
                     Expression of <i>ymgC</i> is regulated under conditions of 
                     biofilm formation.  Deletion of <i>tqsA</i> (encoding the 
                     AI-2 transporter) |CITS: [16385049]| and the presence of 
                     AI-2 |CITS: [11514505][15470704]| or the stationary phase 
                     biofilm signal indole |CITS: [17511876]| repress 
                     <i>ymgC</i> expression.  <i>ymgC</i> is repressed in young 
                     and mature biofilms, but is induced in the intermediate, 
                     developed biofilms |CITS: [17222132]| and by rapid acid 
                     treatment |CITS: [18302792]|.  Expression of <i>ymgC</i> is
                     regulated by the repressor BluR |CITS: [19240136]| as well 
                     as by MarA |CITS: [31518447]| and is increased under low 
                     temperature growth conditions |CITS: [18174134]|.
                     "
                     /translation="MNNSIPERFIFQCALFKNLEREVFMTHGYVDSHIIDQALRLRLKD
                     ETSVILSDLYLQILQYIEMHKTTLTDIIINDRESVLS"
                     /go_component="cytosol [goid 0005829] [evidence IEA] [PMID
