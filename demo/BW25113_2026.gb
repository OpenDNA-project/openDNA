     gene            4595621..4595857
                     /gene="yjjZ"
                     /locus_tag="b4567"
                     /label=yjjZ
     CDS             4595621..4595857
                     /codon_start=1
                     /gene="yjjZ"
                     /locus_tag="b4567"
                     /product="DUF1435 domain-containing protein YjjZ"
                     /label=yjjZ
                     /note="Expression of <i>yjjZ</i> is significantly
                     decreased in populations adapted to the presence of 
                     ampicillin, tetracycline, and n-butanol |CITS: [28217741]|.
                      Repression of <i>yjjZ</i> expression may lead to some 
                     growth improvement in the presence of n-butanol or 
                     n-hexane, although a &Delta;<i>yjjZ</i> mutant grows more 
                     slowly than wild-type |CITS: [30234107]|.
                     A &Delta;<i>yjjZ</i> mutant showed an increased growth rate
                     compared to wild type in the absence of biofuel stress 
                     |CITS: [30234107]|."
                     /translation="MLQRTLGSGWGVLLPGLLIAGLMYADLSSDQWRIVILMGLVLTPM
                     MLYHKQLRHYILLPSCLALIAGIMLMIMNLNQG"
