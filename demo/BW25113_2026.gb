     gene            complement(2420488..2421270)
                     /gene="argT"
                     /locus_tag="b2310"
                     /label=argT
     CDS             complement(2420488..2421270)
                     /codon_start=1
                     /gene="argT"
                     /locus_tag="b2310"
                     /product="multifunctional lysine/arginine/ornithine ABC
                     transporter periplasmic binding protein / lysine / arginine
                     / ornithine ABC transporter / transport of L-ornithine / 
                     transport of L-arginine / transport of L-lysine"
                     /EC_number="7.4.2.1"
                     /label=argT
                     /note="ArgT is the periplasmic binding protein of an 
                     ATP-dependent uptake system for the basic amino acids 
                     lysine, arginine and ornithine.
                     <i>E. coli argT</i> is 89% similar to <i>argT</i> from 
                     <i>Salmonella typhimurium</i> which encodes a 
                     lysing/arginine/ornithine (LAO) periplasmic binding protein
                     |CITS:[3040734]|.
                     <i>argT</i> is a member of the NtrC regulon; expression is 
                     increased in response to nitrogen starvation |CITS: 
                     [11121068][15289551]|. <i>argT</i> expression increases 
                     during the early response to glucose limitation 
                     |CITS:[11683869][16804185]|). The level of ArgT is 
                     decreased after 4hrs exposure to zinc stress |CITS: 
                     [17122063]|. ArgT is induced during stationary phase and 
                     further induced in late stationary phase; this induction is
                     reduced in <i>clpP</i>, <i>clpA</i> and <i>clpX</i> 
                     protease mutants |CITS: [12486047]|."
                     /translation="MKKSILALSLLVGLSTAASSYAALPETVRIGTDTTYAPFSSKDAK
