     gene            complement(3188080..3188224)
                     /gene="sibD"
                     /locus_tag="b4447"
                     /label=sibD
     misc_RNA        complement(3188080..3188224)
                     /gene="sibD"
                     /locus_tag="b4447"
                     /product="small RNA SibD"
                     /note="The SibD small RNA was first detected during a 
                     comparative genomics screen for sequence conservation 
                     |CITS: [11445539]|.  The <i>yqiK-rfaE</i> intergenic region
                     contains two copies of a repeat sequence element (initially
                     termed QUAD1 and later renamed SIB) that occurs five times 
                     in the <i>E. coli</i> K-12 genome |CITS: 
                     [10673004][11553332][18710431]|.  Many sequence regions 
                     conserved between the SIB elements are predicted to form 
                     stem-loop structures |CITS: [18710431]|.
                     Exchanging the target recognition domains of SibC with 
                     those of SibD enables repression of <i>ibsD</i> expression 
                     by the hybrid RNA |CITS: [20453032]|.
                     Two RNA products arising from <i>sibD</i> have been 
                     detected |CITS: [11553332][18710431]|; the shorter RNA 
                     product may be derived by processing of the longer 
                     transcript |CITS: [18710431]|.  A small open reading frame 
                     encoding the predicted toxic peptide IbsD is located on the
                     opposite strand |CITS: [18710431]|.
                     SibD interacts with the protein |FRAME: EG12866-MONOMER| 
                     |CITS: [36328526]|.
                     SibD is expressed throughout growth in minimal and rich 
                     medium |CITS: [12202758][18710431]|.
                     Deletion of <i>sibD</i> has no detectable effect on cell 
                     growth.  However, in a <i>sibD</i> deletion strain, 
                     expression of SibD from a plasmid must be highly induced to
                     yield viable cells; this appears to be due to 
                     overexpression of the toxic peptide IbsD |CITS: 
                     [18710431]|.
                     Ryx: ""RNA of unknown function at X position (10 minute) in
                     the genome"" |CITS: [11445539]|
                     SibD: ""<b>s</b>hort, <b>i</b>ntergenic, a<b>b</b>undant 
                     sequence"" |CITS: [18710431]|
                     Reviews: |CITS: [12762038][12654996][32213244]|"
     gene            3188125..3188184
                     /gene="ibsD"
                     /locus_tag="b4664"
                     /label=ibsD
     CDS             3188125..3188184
                     /codon_start=1
                     /gene="ibsD"
                     /locus_tag="b4664"
                     /product="putative toxic peptide IbsD"
                     /label=ibsD
                     /note="The small open reading frame IbsD was detected by 
                     similarity to the open reading frames encoded on the 
                     opposite strand of the <i>sib</i> small RNAs |CITS: 
                     [18710431]|.
                     Based on similarity to IbsA and the transformation defect 
                     of a plasmid carrying <i>sibD</i>, overexpression
                     of IbsD is predicted to be toxic to the cell |CITS: 
                     [18710431]|.
                     IbsD: ""<b>i</b>nduction <b>b</b>rings <b>s</b>tasis"" 
                     |CITS: [18710431]|
                     "
                     /translation="MMKLVIILIVLLLVSFAAY"
                     /go_component="plasma membrane [goid 0005886] [evidence
                     RCA] [PMID 27510400]"
                     /go_component="plasma membrane [goid 0005886] [evidence
                     IEA] [PMID 26602691]"
