     gene            3296807..3297814
                     /gene="yhbW"
                     /locus_tag="b3160"
                     /label=yhbW
     CDS             3296807..3297814
                     /codon_start=1
                     /gene="yhbW"
                     /locus_tag="b3160"
                     /product="putative luciferase-like monooxygenase YhbW"
                     /label=yhbW
                     /note="<i>yhbW</i> encodes a predicted luciferase-like 
                     monooxygenase |CITS: [18253509]|.  YhbW abundance is more 
                     than 77-fold increased during growth with vanillin, but the
                     purified enzyme does not appear to be able to oxidize 
                     vanillin to vanillic acid |CITS: [31186336]|.
                     <i>yhbW</i> is a multicopy suppressor of the lethal 
                     phenotype of inhibition of &sigma;<sup>E</sup>.  In the 
                     presence of overexpressed <i>yhbW</i>, &sigma;<sup>E</sup> 
                     is no longer required for viability |CITS: [18253509]|.
                     "
                     /translation="MTDKTIAFSLLDLAPIPEGSSAREAFSHSLDLARLAEKRGYHRYW
                     LAEHHNMTGIASAATSVLIGYLAANTTTLHLGSGGVMLPNHSPLVIAEQFGTLNTLYPG
