     gene            complement(2739793..2741154)
                     /gene="ffh"
                     /locus_tag="b2610"
                     /label=ffh
     CDS             complement(2739793..2741154)
                     /codon_start=1
                     /gene="ffh"
                     /locus_tag="b2610"
                     /product="bifunctional signal recognition particle protein 
                     component / Signal Recognition Particle"
                     /label=ffh
                     /note="The structure of Ffh has been analyzed alone and in
                     a complex with the 4.5 S RNA |CITS:[16005894], [15923378]|.
                     Ffh contains two domains: a methionine rich M domain and an
                     NG domain containing an N-terminal 4 helix bundle plus a G 
                     region which contains the signature motifs of the GTPase 
                     family. 4.5S RNA folds into a single hairpin structure 
                     containing an apical GGAA tetraloop that caps one end plus 
                     five symmetric or asymmetic internal loops (reviews: |CITS:
                     [1707519], [7518075]|. The two ends of the 4.5S RNA hairpin
                     have distinct functions in the targeting cycle |CITS: 
                     [23235881]|.
                     Oxidized Ffh is unable to bind 4.5 S RNA and requires the 
                     activity of methionine sulfoxide reductases to
                     return it to its reduced form |CITS:[15057280]|.
                     ffh: <U>f</U>ifty <U>f</U>our <U>h</U>omologue"
                     /translation="MFDNLTDRLSRTLRNISGRGRLTEDNVKDTLREVRMALLEADVAL
                     PVVREFINRVKEKAVGHEVNKSLTPGQEFVKIVRNELVAAMGEENQTLNLAAQPPAVVL
                     MAGLQGAGKTTSVGKLGKFLREKHKKKVLVVSADVYRPAAIKQLETLAEQVGVDFFPSD
                     VGQKPVDIVNAALKEAKLKFYDVLLVDTAGRLHVDEAMMDEIKQVHASINPVETLFVVD
