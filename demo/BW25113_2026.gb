     misc_RNA        complement(2646715..2646814)
                     /gene="timR"
                     /locus_tag="b4811"
                     /product="putative small regulatory RNA TimR"
                     /note="In <i>Salmonella</i> Typhimurium SL1344, the
                     homologous small regulatory RNA TimR represses the 
                     expression of the small toxic protein TimP by inhibiting 
                     its translation |CITS: [33172998]|."
     gene            2647214..2647517
                     /gene="ryfA"
                     /locus_tag="b4440"
                     /label=ryfA
     misc_RNA        2647214..2647517
                     /gene="ryfA"
                     /locus_tag="b4440"
                     /product="small regulatory RNA RyfA"
                     /note="RyfA is a small RNA reported to be approximately
                     320 nt |CITS: [11445539]|, 302 nt |CITS: [12654996]|, or 
                     300 nt |CITS: [11553332]| in length.  RyfA RNA contains a 
                     PAIR3 repeat |CITS: [11445539]|.  RyfA may be identical to 
                     IS128 |CITS: [12069726]|.  In an RNA-RNA interactome 
                     screen, RyfA was found to be associated with the RNA 
                     chaperone ProQ |CITS: [31761494]|.
                     RyfA appears to have some genetic interactions with other 
                     sRNAs under different growth conditions |CITS: [35920556]|.
                     In <i>Salmonella</i> Typhimurium SL1344, the RyfA RNA was 
                     found to encode a small toxic protein, TimP |CITS: 
                     [33172998]|.
                     Overexpression of RyfA leads to slower growth and decreases
                     curli expression, biofilm formation and swarming motility 
                     |CITS: [26469694]|.
                     <i>ryfA</i> is expressed during exponential growth |CITS: 
                     [11445539]|.
                     Ryx: ""RNA of unknown function at X position (10 minute) in
                     the genome"" |CITS: [11445539]|
                     Reviews: |CITS: [12762038][12654996][32213244]|"
