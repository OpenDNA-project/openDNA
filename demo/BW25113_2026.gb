     gene            2147127..2147262
                     /gene="sibB"
                     /locus_tag="b4437"
                     /label=sibB
     misc_RNA        2147127..2147262
                     /gene="sibB"
                     /locus_tag="b4437"
                     /product="small RNA SibB"
                     /note="The SibB small RNA was first detected during a 
                     comparative genomics screen for sequence conservation 
                     |CITS: [11445539]|.  The <i>yegL-yegM</i> intergenic region
                     was initially shown to contain two copies of a repeat 
                     sequence element (initially termed QUAD1 and later renamed 
                     SIB) that occurs five times in the <i>E. coli</i> K-12 
                     genome |CITS: [10673004][18710431]|.  Many sequence regions
                     conserved between the SIB elements are predicted to form 
                     stem-loop structures |CITS: [18710431]|.
                     SibB interacts with the protein |FRAME: EG12866-MONOMER| 
                     |CITS: [36328526]|.
                     Two RNA products arising from <i>sibB</i> have been 
                     detected |CITS: [11445539][18710431]|; the shorter RNA 
                     product may be derived by processing of the longer 
                     transcript |CITS: [18710431]|.  A small open reading frame 
                     encoding the predicted toxic peptide IbsB is located on the
                     opposite strand |CITS: [18710431]|.
                     SibB is expressed at varying levels throughout growth; the 
                     RNA level is generally higher in minimal medium than in 
                     rich medium |CITS: [11445539][18710431]|.
                     Deletion of <i>sibB</i> has no detectable effect on cell 
                     growth.  However, in a <i>sibB</i> deletion strain, 
                     expression of SibB from a plasmid must be highly induced to
                     yield viable cells; this appears to be due to 
                     overexpression of the toxic peptide IbsB |CITS: 
                     [18710431]|.  The SibB/IbsB locus was found in a 
                     genome-wide CRISPRi screen for genes that enable decoupling
                     of growth and GFP accumulation |CITS: [32268068]|.
                     Ryx: ""RNA of unknown function at X position (10 minute) in
                     the genome"" |CITS: [11445539]|
                     SibA: ""<b>s</b>hort, <b>i</b>ntergenic, a<b>b</b>undant 
                     sequence"" |CITS: [18710431]|
                     Reviews: |CITS: [12762038][12654996][32213244]|"
     gene            complement(2147162..2147218)
                     /gene="ibsB"
                     /locus_tag="b4668"
                     /label=ibsB
     CDS             complement(2147162..2147218)
                     /codon_start=1
                     /gene="ibsB"
                     /locus_tag="b4668"
                     /product="putative toxic peptide IbsB"
                     /label=ibsB
                     /note="The small open reading frame IbsB was detected by 
                     similarity to the open reading frames encoded on the 
                     opposite strand of the <i>sib</i> small RNAs |CITS: 
                     [18710431]|.
                     Based on similarity to IbsA and the transformation defect 
                     of a plasmid carrying <i>sibB</i>, overexpression
                     of IbsB is predicted to be toxic to the cell |CITS: 
                     [18710431]|.  The SibB/IbsB locus was found in a 
                     genome-wide CRISPRi screen for genes that enable decoupling
                     of growth and GFP accumulation |CITS: [32268068]|.
                     IbsB: ""<b>i</b>nduction <b>b</b>rings <b>s</b>tasis"" 
                     |CITS: [18710431]|
                     "
