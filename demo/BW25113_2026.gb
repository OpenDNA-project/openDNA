     CDS             complement(3594388..3595446)
                     /codon_start=1
                     /gene="ftsX"
                     /locus_tag="b3462"
                     /product="bifunctional cell division protein FtsX /
                     divisome protein complex FtsEX"
                     /label=ftsX
                     /note="FtsE and FtsX localize to the cell division site; 
                     localization is dependent on FtsZ, FtsA and ZipA, but not 
                     FtsK, FtsQ,
                     FtsL and FtsI |CITS: [14729705]|.  FtsEX is important for 
                     assembly or stability of the septal ring under low-salt 
                     growth conditions |CITS: [14729705]|.
                     FtsX contains 4 transmembrane region with the C and N 
                     terminus located in the cytoplasm; a large periplasmic loop
                     is located between the first and second transmembrane 
                     region |CITS: [19376877]|.  FtsX-GFP localizes to the 
                     septal ring in a <i>ftsEX</i> null mutant |CITS: 
                     [19376877]|.
                     FtsS: |CITS: [6394955]|<br>FtsX: ""<b>f</b>ilamentous 
                     <b>t</b>emperature <b>s</b>ensitive <b>X</b>""
                     Review: |CITS: [35408901][37524757]|"
