     gene            complement(2397430..2398092)
                     /gene="nuoB"
                     /locus_tag="b2287"
                     /label=nuoB
     CDS             complement(2397430..2398092)
                     /codon_start=1
                     /gene="nuoB"
                     /locus_tag="b2287"
                     /product="multifunctional NADH:quinone oxidoreductase
                     subunit B / NADH:quinone oxidoreductase I, peripheral arm /
                     NADH:quinone oxidoreductase I / NADH:ubiquinone 
                     oxidoreductase (H(+)-transporting) / NADH:menaquinone 
                     oxidoreductase (H(+)-transporting)"
                     /EC_number="7.1.1.2"
                     /label=nuoB
                     /note="NuoB is part of the connecting fragment of NADH 
                     dehydrogenase I |CITS: [7607227]|.
                     This subunit contains the N2 4Fe-4S cluster |CITS: 
                     [7690854][9593861][12975362]|, which may play a role in 
                     proton translocation activity of NDH I |CITS: [10978175]|. 
                     The Glu67 residue is most likely protonated by oxidation of
                     the N2 cluster, and is involved in proton translocation 
                     |CITS: [16807239]|.  A mechanism by which the redox 
                     reaction at the N2 cluster induces conformational changes 
                     leading to proton translocation has been proposed |CITS: 
                     [20214873]|.
                     Point mutations in NuoB have been analyzed; the Tyr114 and 
                     Tyr139 residues appear to be protonated upon
                     reduction of the 4Fe-4S cluster, and a double mutant 
                     retains only 20% activity |CITS: [12446673]|.  Mutagenesis 
                     of
                     the conserved acidic residues E67, D77, and D94 abolishes 
                     electron transfer activity of NDH I |CITS: [16807239]|. 
                     Enzymes containing these mutant subunits have been 
                     characterized by FT-IR difference spectroscopy to evaluate 
                     conformational changes |CITS: [20214873]|.
                     In the presence of NADH or reducing agents, crosslinking 
                     between NuoB and NuoI in the intact Complex I is abolished,
                     indicating a conformational change involving the 
                     hydrophilic subunits in the presence of NADH |CITS: 
                     [18771280]|.
                     Null mutants of all individual <i>nuo</i> genes have a 
                     growth defect under aerobic conditions in rich medium 
                     |CITS: [22063474]|.
                     NuoB: ""<b>N</b>ADH:<b>u</b>biquinone 
                     <b>o</b>xidoreductase"" |CITS: [8387992]|
                     Review: |CITS: [16645316]|"
