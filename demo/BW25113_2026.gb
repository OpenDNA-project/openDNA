     gene            complement(1103240..1104397)
                     /gene="opgC"
                     /locus_tag="b1047"
                     /label=opgC
     CDS             complement(1103240..1104397)
                     /codon_start=1
                     /gene="opgC"
                     /locus_tag="b1047"
                     /product="osmoregulated periplasmic glucans (OPG)
                     biosynthesis protein C"
                     /label=opgC
                     /note="OpgC is required for wild-type succinyl
                     modification of the branched periplasmic oligosaccharides 
                     known as |FRAME: CPD-16398 osmoregulated periplasmic 
                     glucans| (OPG), formerly called membrane-derived 
                     oligosaccharides (MDO). The origin of the succinyl group is
                     not known but is suggested to be |FRAME: SUC-COA| (see 
                     |CITS: [28593831]|).
                     OPGs extracted from <i>opgC</i><sup>-</sup> cells (strain 
                     NFB1864 <i>mdoB214</i>::Tn<i>10 mdoC1</i>::Tn<i>5</i>) are 
                     devoid of succinyl residues |CITS: [10368134]|. 
                     Succinylation of OPGs is not osmodependent |CITS: 
                     [26790533]|.
                     OpgC is predicted to be an innner membrane protein with 10 
                     transmembrane domains |CITS: [10368134]|.
                     In the Transporter Classification Database |CITS: 
                     [26546518]| OpgC is a member of the 
                     Acyltransferase-3/Putative Acetyl-CoA Transporter (ATAT) 
                     family.
                     "
