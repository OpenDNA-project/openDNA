     gene            716039..716296
                     /gene="ybfK"
                     /locus_tag="b4590"
                     /label=ybfK
                     /note="The <i>ybfK</i> gene has been deaccessioned due to 
                     experimental evidence for the SpeFL leader peptide (|CITS: 
                     [32094585]|) encoded on the opposite strand.
                     Former UniProt ID:P46121"
                     /note="/phantom"
     gene            complement(716174..716278)
                     /gene="speFL"
                     /locus_tag="b4803"
                     /label=speFL
     CDS             complement(716174..716278)
                     /codon_start=1
                     /gene="speFL"
                     /locus_tag="b4803"
                     /product="leader peptide SpeFL"
                     /label=speFL
                     /note="The SpeFL leader peptide enables regulation of 
                     translation of the |FRAME: ORNDECARBOXDEG-MONOMER| (SpeF) 
                     by transcriptional attenuation |CITS: [32094585]|.  The 
                     authors of |CITS: [32094585]| propose a model for 
                     regulation: in the presence of ornithine, the substrate for
                     SpeF, the leading ribosome translating the <i>speFL</i> ORF
                     stalls when codon 34 is located in the ribosomal P-site.  
                     The stalled ribosome occludes the <i>rut</i> site for 
                     |FRAME: EG10845-MONOMER| binding, and transcription and 
                     translation can continue.  In the absence of ornithine, the
                     stalled ribosome terminates, allowing Rho to bind to the 
                     <i>rut</i> site and terminate transcription.
                     Potential ribosome pausing at two consecutive rare arginine
                     codons, in particular R12, contributes to induction of SpeF
                     expression |CITS: [32094585]|.
                     Cryo-EM structures of nascent SpeFL-ribosome complexes 
                     stalled in the presence of ornithine show that the N 
                     terminus of the nascent peptide forms a hairpin structure 
                     (termed the ""sensor domain"") inside the ribosomal exit 
                     tunnel; together with specific sites of the 23S rRNA, a 
                     cavity containing ornithine is formed.  Compaction of the 
                     C-terminal ""effector domain"" of SpeFL due to continued 
                     translation is proposed to impede binding of release 
                     factors by changing the conformation of U2585 in 23S rRNA, 
                     causing ribosome stalling |CITS: [32094585]|.
                     "
                     /translation="MENNSRTMPHIRRTTHIMKFAHRNSFDFHFFNAR"
                     /go_function="RNA binding [goid 0003723] [evidence IEA]
                     [GO_REF 0000043]"
                     /go_function="rRNA binding [goid 0019843] [evidence IEA]
                     [GO_REF 0000043]"
                     /go_process="regulation of translation [goid 0006417]
                     [evidence IEA] [GO_REF 0000043]"
