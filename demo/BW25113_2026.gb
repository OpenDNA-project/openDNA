     CDS             130875..131237
                     /codon_start=1
                     /gene="yacL"
                     /locus_tag="b0119"
                     /product="PF06062 family protein YacL"
                     /label=yacL
                     /note="YacL was identified in a phylogenetic screen that
                     found proteins containing domains that only occur in 
                     organisms that also contain a |FRAME: EG10204-MONOMER Dam| 
                     methyltransferase |CITS: [16787973]|.  Crosslinking mass 
                     spectrometry-based protein-protein interaction data has 
                     placed the YacL protein near the DNA exit tunnel of RNA 
                     polymerase |CITS: [34117231]|.
                     A <i>yacL</i> in-frame deletion strain has been constructed
                     |CITS: [12142427]|.  Expression of YacL is negatively 
                     regulated by the small RNA CyaR |CITS: [29294085]|."
                     /translation="MDYEFLRDITGVVKVRMSMGHEVVGHWFNEEVKENLALLDEVEQA
