     gene            2853119..2853775
                     /gene="pphB"
                     /locus_tag="b2734"
                     /label=pphB
     CDS             2853119..2853775
                     /codon_start=1
                     /gene="pphB"
                     /locus_tag="b2734"
                     /product="trifunctional phosphoprotein phosphatase 2 / 
                     protein-tyrosine phosphatase / protein-serine/threonine 
                     phosphatase"
                     /EC_number="3.1.3.48; 3.1.3.16"
                     /label=pphB
                     /note="PphA and PphB are phosphoprotein phosphatases that
                     act in transduction of the misfolded protein stress signal 
                     in a pathway that includes the |FRAME: PWY0-1485| and which
                     activates transcription of <i>htrA</i>.  PphB exhibits 
                     phosphatase activity toward phosphorylated serine/threonine
                     and phosphorylated tyrosine in protein substrates.  
                     Additional phosphoproteins accumulate in a <i>pphB</i> 
                     mutant, suggesting that they are <i>in vivo</i> targets of 
                     PphB |CITS: [9130712]|.
                     PphA and PphB have similarity to the phosphoprotein 
                     phosphatase of bacteriophage lambda (&lambda;-PP) |CITS: 
                     [11467953]| and to <i>Salmonella enterica</i> serovar 
                     Typhimurium PrpA and PrpB proteins |CITS: [11717262]|.
                     A <i>pphB</i> null mutant has a slow growth phenotype 
                     |CITS: [9130712]|.
                     PrpB: ""<b>pr</b>otein <b>p</b>hosphatase <b>B</b>"" |CITS:
                     [9130712]|
                     Reviews: |CITS: [9383148][14977554]|
                     "
