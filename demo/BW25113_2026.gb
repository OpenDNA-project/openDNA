     gene            complement(3343165..3343818)
                     /gene="elbB"
                     /locus_tag="b3209"
                     /label=elbB
     CDS             complement(3343165..3343818)
                     /codon_start=1
                     /gene="elbB"
                     /locus_tag="b3209"
                     /product="bifunctional low activity glyoxalase ElbB /
                     glyoxalase III"
                     /label=elbB
                     /note="ElbB belongs to the DJ-1/ThiJ/PfpI superfamily of 
                     proteins |CITS: [15070401]|.  A crystal structure has been 
                     solved at 1.65 &Aring; resolution |CITS: [16021622]|, and 
                     the predicted functional site somewhat resembles that of 
                     the human protein DJ-1 |CITS: [17257049]|.  The protein 
                     exhibits low glyoxalase activity with glyoxal, but not 
                     methylglyoxal, as the substrate |CITS: [26678554]|.
                     The ElbB protein cross-reacts with an antibody prepared 
                     against a peptide of the 2.2 region of &sigma;<sup>70</sup>
                     and &sigma;<sup>32</sup> and was therefore originally named
                     sigma cross-reacting protein 27A (SCRP-27A) |CITS: 
                     [1575737]|.
                     <i>elbB</i> was identified in a mutant screen designed to 
                     identify genes involved in the biosynthesis of isopentenyl 
                     diphosphate, a precursor of isoprenoids |CITS: [9603997]|. 
                     Overexpression of <i>elbB</i> from a high-copy number 
                     plasmid improves lycopene production in an engineered 
                     strain |CITS: [17509919]|.  Increased expression of 
                     <i>elbB</i> does not lead to increased resistance to 
                     glyoxal, but may lead to a decrease in carboxymethylated 
                     proteins in glyoxal-treated cells |CITS: [26678554]|. ElbB:
                     ""<b>e</b>nhancing <b>l</b>ycopene <b>b</b>iosynthesis"" 
                     |CITS: [9603997]|"
                     /translation="MKKIGVILSGCGVYDGSEIHEAVLTLLAISRSGAQAVCFAPDKQQ
                     VDVINHLTGEAMTETRNVLIEAARITRGEIRPLAQADAAELDALIVPGGFGAAKNLSNF
