     CDS             complement(2912765..2914105)
                     /codon_start=1
                     /gene="gudX"
                     /locus_tag="b2788"
                     /product="glucarate dehydratase-related protein"
                     /label=gudX
                     /note="GudX (GlucD-related protein, GlucDRP) has
                     similarity to the functional <i>D</i>-glucarate 
                     dehydratase, GudD, which is encoded in a probable operon 
                     downstream of <i>gudX</i>.  Purified GudX has only very 
                     weak <i>D</i>-glucarate dehydratase and <i>L</i>-idarate 
                     epimerase activity; a physiological substrate has not been 
