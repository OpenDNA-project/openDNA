     gene            complement(2398108..2398551)
                     /gene="nuoA"
                     /locus_tag="b2288"
                     /label=nuoA
     CDS             complement(2398108..2398551)
                     /codon_start=1
                     /gene="nuoA"
                     /locus_tag="b2288"
                     /product="multifunctional NADH:quinone oxidoreductase
                     subunit A / NADH:quinone oxidoreductase I / NADH:ubiquinone
                     oxidoreductase (H(+)-transporting) / NADH:menaquinone 
                     oxidoreductase (H(+)-transporting)"
                     /EC_number="7.1.1.2"
                     /label=nuoA
                     /note="NuoA is part of the inner membrane component of
                     NADH dehydrogenase I |CITS: [7607227]|.  The protein has 
                     three predicted transmembrane domains |CITS: [15175326]|, 
                     and the C terminus is located in the cytoplasm |CITS: 
                     [21925501]|.  Site-specific mutagenesis of conserved 
                     charged amino acid residues has elucidated possible 
                     functional roles for Asp79 and Glu81 |CITS: [15175326]|.
                     A crystal structure of the membrane component at higher 
                     resolution has allowed better identification of the 
                     interactions between the subunits |CITS: [21822288]|.
                     In the presence of NADH, crosslinking between NuoA and NuoJ
                     in the intact Complex I is abolished, indicating that the 
                     conformational change involving the hydrophilic subunits in
                     the presence of NADH extends to the membrane domain |CITS: 
                     [18771280]|.
                     Null mutants of all individual <i>nuo</i> genes have a 
                     growth defect under aerobic conditions in rich medium 
                     |CITS: [22063474]|.
                     NuoA: ""<b>N</b>ADH:<b>u</b>biquinone 
                     <b>o</b>xidoreductase"" |CITS: [8387992]|"
